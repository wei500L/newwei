+}
+
+export interface RSSHubItem {
+  id: string
+  url: string
+  title: string
+  content_html: string
+  date_published: string
+}
+
+export interface RSSHubOption {
+  sorted?: boolean
+  limit?: number
+}
+
+export interface SourceOption {
+  hiddenDate?: boolean
+}
