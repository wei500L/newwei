{
  "name": "@modular/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true TS_NODE_PREFER_TS_EXTS=true NODE_PATH=./node_modules node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && pnpm run copy:email-templates",
    "start": "cross-env NODE_PATH=./node_modules node dist/main.js",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "cross-env NODE_PATH=./node_modules jest",
    "test:e2e": "cross-env NODE_PATH=./node_modules jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles",
    "generate:schema": "cross-env TS_NODE_PREFER_TS_EXTS=true NODE_PATH=./node_modules node -r ts-node/register/transpile-only -r tsconfig-paths/register ./scripts/generate-graphql-schema.ts",
    "economic:fetch": "cross-env TS_NODE_PREFER_TS_EXTS=true NODE_PATH=./node_modules node -r ts-node/register/transpile-only -r tsconfig-paths/register ./scripts/fetch-economic-data.ts",
    "mongo:indexes": "cross-env TS_NODE_PREFER_TS_EXTS=true NODE_PATH=./node_modules node -r ts-node/register/transpile-only -r tsconfig-paths/register ./scripts/ensure-mongo-indexes.ts",
    "processed-item-location:backfill": "cross-env NODE_PATH=./node_modules tsx ./scripts/backfill-processed-item-has-location.ts",
    "raw-item-urls:backfill": "cross-env TS_NODE_PREFER_TS_EXTS=true NODE_PATH=./node_modules node -r ts-node/register/transpile-only -r tsconfig-paths/register ./scripts/backfill-raw-item-comparable-urls.ts",
    "copy:email-templates": "node ./scripts/copy-email-templates.js",
    "vector:backfill": "cross-env NODE_PATH=./node_modules tsx ./scripts/backfill-vector-index.ts",
    "fingerprint:backfill": "cross-env NODE_PATH=./node_modules tsx ./scripts/backfill-canonical-url-fingerprints.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.1",
    "@aws-sdk/client-s3": "^3.823.0",
    "@aws-sdk/s3-request-presigner": "^3.823.0",
    "@bull-board/api": "^6.15.0",
    "@bull-board/express": "^6.15.0",
    "@bull-board/nestjs": "^6.15.0",
    "@bull-board/ui": "^6.15.0",
    "@modular/config": "workspace:*",
    "@modular/db": "workspace:*",
    "@modular/mongo": "workspace:*",
    "@modular/utils": "workspace:*",
    "@modular/vector-client": "workspace:*",
    "@nestjs/apollo": "^12.0.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bull-shared": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "@prisma/client": "^5.16.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.8.1",
    "cheerio": "^1.0.0-rc.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "cron-parser": "^4.9.0",
    "dataloader": "^2.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "dayjs": "^1.11.13",
    "fast-xml-parser": "^4.4.0",
    "iconv-lite": "^0.6.3",
    "graphql": "^16.8.1",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^1.1.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-type-json": "^0.3.2",
    "graphql-ws": "^5.14.2",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "nest-winston": "^1.9.6",
    "nestjs-dataloader": "^9.0.0",
    "nodemailer": "^7.0.7",
    "ofetch": "^1.4.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.0",
    "supercluster": "^8.0.1",
    "telegram": "^2.26.22",
    "winston": "^3.13.0",
    "ws": "^8.17.0",
    "yaml": "^2.4.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^7.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.4.5",
    "@types/supercluster": "^7.1.3"
  }
}
