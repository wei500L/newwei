    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modular/utils": "workspace:*",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@xyflow/react": "^12.10.1",
    "antd": "^5.19.0",
