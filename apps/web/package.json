{
  "name": "@modular/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "graphql-codegen --config codegen.cjs",
    "predev": "pnpm run generate",
    "dev": "next dev --hostname 0.0.0.0",
    "predev:turbo": "pnpm run generate",
    "dev:turbo": "next dev --turbo --hostname 0.0.0.0",
    "prebuild": "pnpm run generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.js",
    "i18n:extract-defaults": "node scripts/i18n-extract-defaults.js --write",
    "i18n:sync": "node scripts/i18n-sync.js",
    "i18n:audit": "node scripts/i18n-audit.js"
  },
  "dependencies": {
