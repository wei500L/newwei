{
  "name": "@modular/mongo",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "node ../../tools/check-no-source-artifacts.js src && eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "mongo:indexes": "tsx cli/ensure-mongo-indexes.ts",
    "mongo:indexes:prune": "tsx cli/prune-mongo-indexes.ts",
    "processed-item-location:backfill": "tsx cli/backfill-processed-item-has-location.ts",
    "raw-item-urls:backfill": "tsx cli/backfill-raw-item-comparable-urls.ts"
  },
  "dependencies": {
    "@modular/utils": "workspace:*",
    "mongoose": "^8.3.2"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7"
  }
}
