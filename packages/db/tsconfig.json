{
  "extends": "../config/tsconfig/library.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@modular/config": ["../../config/src/index.ts"],
      "@modular/config/*": ["../../config/src/*"],
      "@modular/utils": ["../../utils/src/index.ts"],
      "@modular/utils/*": ["../../utils/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/**/*.spec.ts"]
}
