// Prisma schema for primary MySQL storage
// Sharding strategy: orgId acts as the shard key. Multi-tenant tables are indexed on orgId to keep routing/hash-based partitioning cheap.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
  binaryTargets   = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Org {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  planTier    String?
  subscriptionStatus String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  membershipRoles MembershipRole[]
  roles       Role[]
  auditLogs   AuditLog[]
  auditLogOutbox AuditLogOutbox[]
  items       ItemMeta[]
  crawlTasks  CrawlTask[]
  crawlTemplates CrawlTemplate[]
  crawlSiteProfiles CrawlSiteProfile[]
  crawlFrontierRuns CrawlFrontierRun[]
  crawlFrontierNodes CrawlFrontierNode[]
  crawlStrategyWorkflows CrawlStrategyWorkflow[]
  crawlStrategyWorkflowRuns CrawlStrategyWorkflowRun[]
  newsSources NewsSource[]
  pipelineJobs PipelineJob[]
  articles    Article[]
  newsEvents  NewsEvent[]
  newsEventItems NewsEventItem[]
  newsEventTimelineEntries NewsEventTimelineEntry[]
  newsEventIngestionState NewsEventIngestionState?
  dashboards  Dashboard[]
  alertRules  AlertRule[]
  alertChannels AlertNotificationChannel[]
  mongoOutbox MongoOutbox[]
  notifications Notification[]
  knowledgeEntities KnowledgeEntity[]
  knowledgeEntityAliases KnowledgeEntityAlias[]
  knowledgeEdges KnowledgeEdge[]
  knowledgeEdgeEvidences KnowledgeEdgeEvidence[]
  knowledgeGraphIngestionState KnowledgeGraphIngestionState?
  articleEntityLinks ArticleEntityLink[]
  entitySentimentSnapshots EntitySentimentSnapshot[]
  topicSentimentSnapshots TopicSentimentSnapshot[]
  newsnowCandidateSnapshots NewsnowCandidateSnapshot[]
  newsnowDomesticOpinionIndexSnapshots NewsnowDomesticOpinionIndexSnapshot[]
  newsIndicatorAssociations NewsIndicatorAssociation[]
  newsIndicatorAssociationBacktestRuns NewsIndicatorAssociationBacktestRun[]
  rssTranslationMetricsDaily RssTranslationMetricsDaily[]
  userSettings UserSetting[]
  contentSubscriptionCatalog ContentSubscriptionCatalog[]
  userContentSubscriptions UserContentSubscription[]
  situationMonitorMonitors SituationMonitorMonitor[]
  archiveArticleClassifications ArchiveArticleClassification[]
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  pendingEmail  String?       @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  memberships   Membership[]
  auditLogs     AuditLog[]
  refreshTokens  RefreshToken[]
  crawlTasks     CrawlTask[] @relation("CrawlTaskCreatedBy")
  dashboardsCreated Dashboard[] @relation("DashboardCreatedBy")
  alertRulesCreated AlertRule[] @relation("AlertRuleCreatedBy")
  alertChannelsCreated AlertNotificationChannel[] @relation("AlertChannelCreatedBy")
  contentSubscriptions UserContentSubscription[]
  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdatedBy")
  rateLimitPoliciesUpdated RateLimitPolicy[] @relation("RateLimitPolicyUpdatedBy")
  notifications Notification[]
  userSettings UserSetting[]
  situationMonitorMonitors SituationMonitorMonitor[]
}

model Role {
  id          String        @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean       @default(false)
  org         Org           @relation(fields: [orgId], references: [id])
  orgId       String
  permissions RolePermission[]
  memberships Membership[]
  membershipRoles MembershipRole[]

  @@unique([id, orgId])
  @@unique([orgId, name])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id            String      @id @default(cuid())
  role          Role        @relation(fields: [roleId], references: [id])
  roleId        String
  permission    Permission  @relation(fields: [permissionId], references: [id])
  permissionId  String

  @@unique([roleId, permissionId])
}

model Membership {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id])
  userId    String
  org       Org    @relation(fields: [orgId], references: [id])
  orgId     String
  role      Role   @relation(fields: [roleId, orgId], references: [id, orgId])
  roleId    String
  roles     MembershipRole[]
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([roleId, orgId])
  @@unique([id, orgId])
  @@unique([userId, orgId])
}

model MembershipRole {
  membership   Membership @relation(fields: [membershipId, orgId], references: [id, orgId], onDelete: Cascade)
  membershipId String
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  role         Role       @relation(fields: [roleId, orgId], references: [id, orgId], onDelete: Cascade)
  roleId       String
  createdAt    DateTime   @default(now())

  @@id([membershipId, roleId])
  @@index([orgId, membershipId])
  @@index([orgId, roleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  org        Org      @relation(fields: [orgId], references: [id])
  orgId      String
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  resource   String
  action     String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
}

model AuditLogOutbox {
  id          String               @id @default(cuid())
  org         Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  payload     Json
  status      AuditLogOutboxStatus @default(pending)
  attempts    Int                  @default(0)
  lastError   String?
  availableAt DateTime             @default(now())
  lockedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, availableAt])
  @@index([orgId, status])
}

model ItemMeta {
  id          String   @id @default(cuid())
  org         Org      @relation(fields: [orgId], references: [id])
  orgId       String
  externalId  String
  name        String
  status      String   @default("draft")
  mongoRef    String   // references packages/mongo RawItem document id
  version     Int      @default(1)
  publishedAt DateTime?
  sortAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, externalId])
  @@index([orgId, name])
  @@index([orgId, sortAt, id])
  @@fulltext([name, externalId])
}

model CrawlTask {
  id             String           @id @default(cuid())
  org            Org              @relation(fields: [orgId], references: [id])
  orgId          String
  createdBy      User             @relation("CrawlTaskCreatedBy", fields: [createdById], references: [id])
  createdById    String
  targetUrl      String
  displayName    String?
  status         CrawlTaskStatus  @default(pending)
  config         Json?
  timeRangeFrom  DateTime?
  timeRangeTo    DateTime?
  concurrency    Int              @default(1)
  keywords       Json?
  lastRunAt      DateTime?
  lastSuccessAt  DateTime?
  lastResultAt   DateTime?
  lastCursor     String?
  lastError      String?          @db.Text
  runCount       Int              @default(0)
  lastServerMemoryMb    Float?
  lastPeakMemoryMb      Float?
  lastMemoryEfficiency  Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  results        CrawlResult[]

  @@index([orgId, status, updatedAt])
}

model CrawlResult {
  id                 String     @id @default(cuid())
  task               CrawlTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId             String
  orgId              String
  sourceUrl          String
  sourceUrlFingerprint String?  @db.VarChar(64)
  fetchedAt          DateTime
  markdownRef        String
  contentHash        String
  metadata           Json?
  createdAt          DateTime   @default(now())
  mediaAssets CrawlMediaAsset[]

  @@index([sourceUrl])
  @@index([taskId, fetchedAt])
  @@index([orgId, fetchedAt])
  @@index([orgId, contentHash, fetchedAt])
  @@index([orgId, sourceUrlFingerprint, fetchedAt])
  @@unique([taskId, contentHash])
}

model CrawlSiteProfile {
  id            String                 @id @default(cuid())
  org           Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId         String
  name          String
  description   String?
  matchHost     String
  isActive      Boolean                @default(true)
  executionMode CrawlSiteExecutionMode @default(layered)
  workflow      CrawlStrategyWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  workflowId    String?
  workflowVersion CrawlStrategyWorkflowVersion? @relation("CrawlSiteProfileWorkflowVersion", fields: [workflowVersionId], references: [id], onDelete: SetNull)
  workflowVersionId String?
  workflowBindingMode CrawlStrategyWorkflowBindingMode @default(published)
  version       Int                    @default(1)
  config        Json
  createdById   String
  updatedById   String?
  publishedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  versions      CrawlSiteProfileVersion[]
  runs          CrawlFrontierRun[]
  workflowRuns  CrawlStrategyWorkflowRun[]

  @@unique([orgId, name])
  @@index([orgId, isActive, updatedAt])
  @@index([orgId, matchHost, isActive])
  @@index([orgId, workflowId, updatedAt])
}

model CrawlSiteProfileVersion {
  id            String                 @id @default(cuid())
  profile       CrawlSiteProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  orgId         String
  version       Int
  name          String
  description   String?
  matchHost     String
  isActive      Boolean
  executionMode CrawlSiteExecutionMode
  workflowId    String?
  workflowVersionId String?
  workflowBindingMode CrawlStrategyWorkflowBindingMode @default(published)
  config        Json
  createdById   String
  createdAt     DateTime               @default(now())

  @@unique([profileId, version])
  @@index([orgId, createdAt])
}

model CrawlFrontierRun {
  id             String                 @id @default(cuid())
  org            Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId          String
  profile        CrawlSiteProfile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  profileId      String?
  seedUrl        String
  crawlTaskId    String?
  executionMode  CrawlSiteExecutionMode @default(layered)
  status         CrawlFrontierRunStatus @default(pending)
  maxDepth       Int                    @default(3)
  maxPages       Int                    @default(60)
  keywords       Json?
  pageCount      Int                    @default(0)
  nodeCount      Int                    @default(0)
  articleCount   Int                    @default(0)
  failedCount    Int                    @default(0)
  duplicateCount Int                    @default(0)
  nativeRunId    String?
  lastError      String?                @db.Text
  metadata       Json?
  createdById    String
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  nodes          CrawlFrontierNode[]

  @@index([orgId, status, createdAt])
  @@index([orgId, profileId, createdAt])
}

model CrawlStrategyWorkflow {
  id                 String                        @id @default(cuid())
  org                Org                           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId              String
  name               String
  description        String?
  draftDefinition    Json
  publishedVersion   CrawlStrategyWorkflowVersion? @relation("CrawlStrategyWorkflowPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  publishedVersionId String?
  createdById        String
  updatedById        String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  versions           CrawlStrategyWorkflowVersion[] @relation("CrawlStrategyWorkflowVersions")
  runs               CrawlStrategyWorkflowRun[]
  profiles           CrawlSiteProfile[]
  newsSources        NewsSource[]

  @@unique([orgId, name])
  @@index([orgId, updatedAt])
}

model CrawlStrategyWorkflowVersion {
  id                String                        @id @default(cuid())
  workflow          CrawlStrategyWorkflow         @relation("CrawlStrategyWorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId        String
  orgId             String
  version           Int
  name              String
  description       String?
  definition        Json
  createdById       String
  createdAt         DateTime                      @default(now())

  publishedBy       CrawlStrategyWorkflow[]       @relation("CrawlStrategyWorkflowPublishedVersion")
  runs              CrawlStrategyWorkflowRun[]
  boundProfiles     CrawlSiteProfile[]            @relation("CrawlSiteProfileWorkflowVersion")
  boundNewsSources  NewsSource[]                  @relation("NewsSourceWorkflowVersion")

  @@unique([workflowId, version])
  @@index([orgId, createdAt])
}

model CrawlStrategyWorkflowRun {
  id                String                        @id @default(cuid())
  org               Org                           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId             String
  workflow          CrawlStrategyWorkflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId        String
  workflowVersion   CrawlStrategyWorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowVersionId String
  profile           CrawlSiteProfile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  profileId         String?
  newsSource        NewsSource?                   @relation(fields: [newsSourceId], references: [id], onDelete: SetNull)
  newsSourceId      String?
  status            CrawlStrategyWorkflowRunStatus @default(pending)
  runKind           String                        @default("trial")
  input             Json?
  output            Json?
  graphSnapshot     Json?
  stepResults       Json?
  candidates        Json?
  parameterSources  Json?
  error             String?                       @db.Text
  stepCount         Int                           @default(0)
  candidateCount    Int                           @default(0)
  selectedCount     Int                           @default(0)
  createdById       String
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([orgId, createdAt])
  @@index([workflowId, createdAt])
  @@index([workflowVersionId, createdAt])
  @@index([profileId, createdAt])
  @@index([newsSourceId, createdAt])
}

model CrawlFrontierNode {
  id              String                   @id @default(cuid())
  run             CrawlFrontierRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId           String
  parent          CrawlFrontierNode?       @relation("CrawlFrontierNodeToParent", fields: [parentNodeId], references: [id], onDelete: SetNull)
  parentNodeId    String?
  children        CrawlFrontierNode[]      @relation("CrawlFrontierNodeToParent")
  org             Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId           String
  url             String
  canonicalUrl    String?
  urlFingerprint  String?                  @db.VarChar(64)
  pageType        CrawlFrontierPageType
  depth           Int
  queueClass      CrawlQueueClass          @default(normal)
  status          CrawlFrontierNodeStatus  @default(pending)
  score           Float?
  freshnessScore  Float?
  attempts        Int                      @default(0)
  queuedAt        DateTime?
  crawledAt       DateTime?
  crawlResultId   String?
  rejectionReason String?
  lastError       String?                  @db.Text
  metadata        Json?
  discoveredAt    DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([runId, status, depth])
  @@index([orgId, pageType, status])
  @@index([runId, urlFingerprint])
  @@index([runId, parentNodeId])
}

model CrawlMediaAsset {
  id        String                    @id @default(cuid())
  result    CrawlResult               @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId  String
  orgId     String
  taskId    String
  provider  CrawlImageStorageProvider @default(mysql)
  kind      String
  sourceUrl String
  bytes     Int
  contentType String?
  blobData  Bytes?
  storageKey String?
  width     Int?
  height    Int?
  alt       String?
  title     String?
  desc      String?                   @db.Text
  poster    String?
  format    String?
  metadata  Json?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([orgId, resultId])
  @@index([orgId, taskId, createdAt])
  @@index([resultId, createdAt])
}

model SystemSetting {
  key         String   @id
  value       Json
  isPublic    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model UserSetting {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId, key])
  @@index([orgId, userId])
  @@index([orgId, key])
}

enum ContentSubscriptionKind {
  topic
  entity
}

enum ContentSubscriptionSource {
  manual
  recommendation
  related
  legacy
}

enum SituationMonitorMonitorKind {
  manual
  system_sync
}

model UserContentSubscription {
  id              String                    @id @default(cuid())
  org             Org                       @relation(fields: [orgId], references: [id])
  orgId           String
  user            User                      @relation(fields: [userId], references: [id])
  userId          String
  kind            ContentSubscriptionKind
  normalizedValue String
  displayValue    String
  taxonomyPath    String?
  taxonomyVersion String?
  source          ContentSubscriptionSource @default(manual)
  metadata        Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([orgId, userId, kind, normalizedValue])
  @@index([orgId, userId, kind, createdAt])
  @@index([orgId, userId, updatedAt])
  @@index([orgId, taxonomyPath, kind])
}

model SituationMonitorMonitor {
  id                   String                     @id @default(cuid())
  org                  Org                        @relation(fields: [orgId], references: [id])
  orgId                String
  user                 User                       @relation(fields: [userId], references: [id])
  userId               String
  kind                 SituationMonitorMonitorKind @default(manual)
  name                 String
  enabled              Boolean                    @default(true)
  color                String?
  rawKeywords          Json
  approvedTopics       Json
  approvedEntities     Json
  approvedLexicalTerms Json
  rejectedSuggestions  Json?
  locationName         String?
  locationLat          Float?
  locationLng          Float?
  locationBounds       Json?
  locationCountryCode  String?
  queryEmbeddingModel  String?
  queryEmbeddingVector Json?
  lastResolvedAt       DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([orgId, userId, kind, updatedAt])
  @@index([orgId, userId, createdAt])
}

model ContentSubscriptionCatalog {
  id              String                  @id @default(cuid())
  org             Org                     @relation(fields: [orgId], references: [id])
  orgId           String
  kind            ContentSubscriptionKind
  normalizedValue String
  displayValue    String
  count           Int
  lastSeenAt      DateTime
  taxonomyPath    String?
  taxonomyVersion String?
  embeddingModel  String?
  embeddingVector Json?
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([orgId, kind, normalizedValue])
  @@index([orgId, kind, count])
  @@index([orgId, kind, lastSeenAt])
  @@index([orgId, taxonomyPath, kind])
}

model RateLimitPolicy {
  feature       String   @id
  userLimit     Int
  ipLimit       Int
  windowSeconds Int
  enabled       Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     User?    @relation("RateLimitPolicyUpdatedBy", fields: [updatedById], references: [id])
  updatedById   String?
}

enum CrawlTaskStatus {
  pending
  queued
  running
  completed
  failed
  paused
}

enum CrawlSiteExecutionMode {
  layered
  native
  hybrid
}

enum CrawlFrontierRunStatus {
  pending
  queued
  running
  completed
  failed
  canceled
}

enum CrawlFrontierPageType {
  home
  category
  list
  article
}

enum CrawlFrontierNodeStatus {
  pending
  queued
  running
  completed
  failed
  skipped
  canceled
}

enum CrawlStrategyWorkflowBindingMode {
  published
  pinned
}

enum CrawlStrategyWorkflowRunStatus {
  pending
  running
  completed
  failed
}

enum CrawlQueueClass {
  hot
  normal
}

enum CrawlImageStorageProvider {
  mysql
  s3
}

model CrawlTemplate {
  id           String   @id @default(cuid())
  org          Org      @relation(fields: [orgId], references: [id])
  orgId        String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  crawlOptions Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  newsSources NewsSource[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
}

model NewsSource {
  id               String          @id @default(cuid())
  org              Org             @relation(fields: [orgId], references: [id])
  orgId            String
  name             String
  url              String
  siteType         NewsSourceType  @default(general)
  language         String?
  crawlTemplate    CrawlTemplate?  @relation(fields: [crawlTemplateId], references: [id], onDelete: SetNull)
  crawlTemplateId  String?
  workflow         CrawlStrategyWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  workflowId       String?
  workflowVersion  CrawlStrategyWorkflowVersion? @relation("NewsSourceWorkflowVersion", fields: [workflowVersionId], references: [id], onDelete: SetNull)
  workflowVersionId String?
  workflowBindingMode CrawlStrategyWorkflowBindingMode @default(published)
  frequencySeconds Int             @default(3600)
  priority         Int             @default(0)
  isActive         Boolean         @default(true)
  config           Json?
  group            String?
  lastRunAt        DateTime?
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  consecutiveFailures Int          @default(0)
  circuitOpenUntil DateTime?
  nextRunAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  jobs     PipelineJob[]
  articles Article[]
  workflowRuns CrawlStrategyWorkflowRun[]

  @@index([isActive, nextRunAt])
  @@unique([orgId, url])
  @@index([orgId, group])
  @@index([orgId, workflowId, updatedAt])
}

model PipelineJob {
  id           String            @id @default(cuid())
  org          Org               @relation(fields: [orgId], references: [id])
  orgId        String
  source       NewsSource?       @relation(fields: [sourceId], references: [id])
  sourceId     String?
  url          String
  urlFingerprint String?         @db.VarChar(64)
  priority     Int               @default(0)
  status       PipelineJobStatus @default(pending)
  queueName    String            @default("crawl-queue")
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  attempts     Int               @default(0)
  error        String?           @db.Text
  crawlRunId   String?
  article      Article?          @relation(fields: [articleId], references: [id])
  articleId    String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([orgId, status])
  @@index([queueName, status])
  @@index([sourceId, createdAt])
  @@index([sourceId, urlFingerprint, createdAt])
}

model Article {
  id          String        @id @default(cuid())
  org         Org           @relation(fields: [orgId], references: [id])
  orgId       String
  source      NewsSource?   @relation(fields: [sourceId], references: [id])
  sourceId    String?
  url         String        @db.VarChar(512)
  urlFingerprint String?    @db.VarChar(64)
  sourceLabel String?
  language    String?
  titleGuess  String?
  crawlAt     DateTime
  contentHash String        @unique
  markdownRef String?
  version     Int           @default(1)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  jobs      PipelineJob[]
  processed ProcessedArticle?
  knowledgeEdgeEvidences KnowledgeEdgeEvidence[]
  entityLinks ArticleEntityLink[]
  archiveClassification ArchiveArticleClassification?

  @@unique([url, contentHash])
  @@index([orgId, sourceId, crawlAt])
  @@index([orgId, urlFingerprint, crawlAt])
}

model ProcessedArticle {
  id                 String   @id @default(cuid())
  article            Article  @relation(fields: [articleId], references: [id])
  articleId          String   @unique
  status             ProcessedArticleStatus @default(completed)
  title              String?
  subtitle           String?
  author             String?
  source             String?
  publishedAt        DateTime?
  category           String?
  topics             Json?
  summary            String? @db.Text
  keyPoints          Json?
  entities           Json?
  kgRelations        Json?
  cleanedMarkdownRef String?
  removedNoiseTypes  Json?
  qualityScore       Float?
  llmModel           String?
  llmPromptVersion   String?
  language           String?
  location           String?
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
