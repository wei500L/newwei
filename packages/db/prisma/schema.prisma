// Prisma schema for primary MySQL storage
// Sharding strategy: orgId acts as the shard key. Multi-tenant tables are indexed on orgId to keep routing/hash-based partitioning cheap.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
  binaryTargets   = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Org {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  planTier    String?
  subscriptionStatus String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  membershipRoles MembershipRole[]
  roles       Role[]
  auditLogs   AuditLog[]
  auditLogOutbox AuditLogOutbox[]
  items       ItemMeta[]
  crawlTasks  CrawlTask[]
  newsSources NewsSource[]
  pipelineJobs PipelineJob[]
  articles    Article[]
  dashboards  Dashboard[]
  alertRules  AlertRule[]
  alertChannels AlertNotificationChannel[]
  mongoOutbox MongoOutbox[]
  notifications Notification[]
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  memberships   Membership[]
  auditLogs     AuditLog[]
  refreshTokens  RefreshToken[]
  crawlTasks     CrawlTask[] @relation("CrawlTaskCreatedBy")
  dashboardsCreated Dashboard[] @relation("DashboardCreatedBy")
  alertRulesCreated AlertRule[] @relation("AlertRuleCreatedBy")
  alertChannelsCreated AlertNotificationChannel[] @relation("AlertChannelCreatedBy")
  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdatedBy")
  rateLimitPoliciesUpdated RateLimitPolicy[] @relation("RateLimitPolicyUpdatedBy")
  notifications Notification[]
}

model Role {
  id          String        @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean       @default(false)
  org         Org           @relation(fields: [orgId], references: [id])
  orgId       String
  permissions RolePermission[]
  memberships Membership[]
  membershipRoles MembershipRole[]

  @@unique([id, orgId])
  @@unique([orgId, name])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id            String      @id @default(cuid())
  role          Role        @relation(fields: [roleId], references: [id])
  roleId        String
  permission    Permission  @relation(fields: [permissionId], references: [id])
  permissionId  String

  @@unique([roleId, permissionId])
}

model Membership {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id])
  userId    String
  org       Org    @relation(fields: [orgId], references: [id])
  orgId     String
  role      Role   @relation(fields: [roleId, orgId], references: [id, orgId])
  roleId    String
  roles     MembershipRole[]
  createdAt DateTime @default(now())

  @@index([roleId, orgId])
  @@unique([id, orgId])
  @@unique([userId, orgId])
}

model MembershipRole {
  membership   Membership @relation(fields: [membershipId, orgId], references: [id, orgId], onDelete: Cascade)
  membershipId String
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  role         Role       @relation(fields: [roleId, orgId], references: [id, orgId], onDelete: Cascade)
  roleId       String
  createdAt    DateTime   @default(now())

  @@id([membershipId, roleId])
  @@index([orgId, membershipId])
  @@index([orgId, roleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  org        Org      @relation(fields: [orgId], references: [id])
  orgId      String
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  resource   String
  action     String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
}

model AuditLogOutbox {
  id          String               @id @default(cuid())
  org         Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  payload     Json
  status      AuditLogOutboxStatus @default(pending)
  attempts    Int                  @default(0)
  lastError   String?
  availableAt DateTime             @default(now())
  lockedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, availableAt])
  @@index([orgId, status])
}

model ItemMeta {
  id          String   @id @default(cuid())
  org         Org      @relation(fields: [orgId], references: [id])
  orgId       String
  externalId  String
  name        String
  status      String   @default("draft")
  mongoRef    String   // references packages/mongo RawItem document id
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, externalId])
  @@index([orgId, name])
  @@fulltext([name, externalId])
}

model CrawlTask {
  id             String           @id @default(cuid())
  org            Org              @relation(fields: [orgId], references: [id])
  orgId          String
  createdBy      User             @relation("CrawlTaskCreatedBy", fields: [createdById], references: [id])
  createdById    String
  targetUrl      String
  displayName    String?
  status         CrawlTaskStatus  @default(pending)
  config         Json?
  timeRangeFrom  DateTime?
  timeRangeTo    DateTime?
  concurrency    Int              @default(1)
  keywords       Json?
  lastRunAt      DateTime?
  lastSuccessAt  DateTime?
  lastResultAt   DateTime?
  lastCursor     String?
  lastError      String?
  runCount       Int              @default(0)
  lastServerMemoryMb    Float?
  lastPeakMemoryMb      Float?
  lastMemoryEfficiency  Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  results        CrawlResult[]

  @@index([orgId, status, updatedAt])
}

model CrawlResult {
  id          String     @id @default(cuid())
  task        CrawlTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  sourceUrl   String
  fetchedAt   DateTime
  markdownRef String
  contentHash String
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([sourceUrl])
  @@index([taskId, fetchedAt])
  @@unique([taskId, contentHash])
}

model SystemSetting {
  key         String   @id
  value       Json
  isPublic    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
}

model RateLimitPolicy {
  feature       String   @id
  userLimit     Int
  ipLimit       Int
  windowSeconds Int
  enabled       Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     User?    @relation("RateLimitPolicyUpdatedBy", fields: [updatedById], references: [id])
  updatedById   String?
}

enum CrawlTaskStatus {
  pending
  queued
  running
  completed
  failed
  paused
}

model NewsSource {
  id               String          @id @default(cuid())
  org              Org             @relation(fields: [orgId], references: [id])
  orgId            String
  name             String
  url              String
  siteType         NewsSourceType  @default(general)
  language         String?
  frequencySeconds Int             @default(3600)
  priority         Int             @default(0)
  isActive         Boolean         @default(true)
  config           Json?
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  jobs     PipelineJob[]
  articles Article[]

  @@unique([orgId, url])
}

model PipelineJob {
  id           String            @id @default(cuid())
  org          Org               @relation(fields: [orgId], references: [id])
  orgId        String
  source       NewsSource?       @relation(fields: [sourceId], references: [id])
  sourceId     String?
  url          String
  priority     Int               @default(0)
  status       PipelineJobStatus @default(pending)
  queueName    String            @default("crawl-queue")
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  attempts     Int               @default(0)
  error        String?
  crawlRunId   String?
  article      Article?          @relation(fields: [articleId], references: [id])
  articleId    String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([orgId, status])
  @@index([queueName, status])
  @@index([sourceId, createdAt])
}

model Article {
  id          String        @id @default(cuid())
  org         Org           @relation(fields: [orgId], references: [id])
  orgId       String
  source      NewsSource?   @relation(fields: [sourceId], references: [id])
  sourceId    String?
  url         String
  sourceLabel String?
  language    String?
  titleGuess  String?
  crawlAt     DateTime
  contentHash String        @unique
  markdownRef String?
  version     Int           @default(1)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  jobs      PipelineJob[]
  processed ProcessedArticle?

  @@unique([url, contentHash])
  @@index([orgId, sourceId, crawlAt])
}

model ProcessedArticle {
  id                 String   @id @default(cuid())
  article            Article  @relation(fields: [articleId], references: [id])
  articleId          String   @unique
  title              String?
  subtitle           String?
  author             String?
  source             String?
  publishedAt        DateTime?
  category           String?
  topics             Json?
  summary            String?
  keyPoints          Json?
  entities           Json?
  cleanedMarkdownRef String?
  removedNoiseTypes  Json?
  qualityScore       Float?
  llmModel           String?
  llmPromptVersion   String?
  language           String?
  location           String?
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  costUsd            Float?
  latencyMs          Int?
  createdAt          DateTime @default(now())
  processedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MongoOutbox {
  id          String             @id @default(cuid())
  org         Org                @relation(fields: [orgId], references: [id])
  orgId       String
  type        MongoOutboxType    @default(processed_item)
  payload     Json
  status      MongoOutboxStatus  @default(pending)
  attempts    Int                @default(0)
  lastError   String?
  availableAt DateTime           @default(now())
  lockedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, availableAt])
  @@index([orgId, status])
}

model Dashboard {
  id          String            @id @default(cuid())
  org         Org               @relation(fields: [orgId], references: [id])
  orgId       String
  name        String
  slug        String
  description String?
  theme       String?
  config      Json?
  createdBy   User?             @relation("DashboardCreatedBy", fields: [createdById], references: [id])
  createdById String?
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  widgets     DashboardWidget[]

  @@unique([orgId, slug])
}

model DashboardWidget {
  id           String               @id @default(cuid())
  dashboard    Dashboard            @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  dashboardId  String
  title        String?
  type         DashboardWidgetType
  dataSource   String
  dataConfig   Json?
  layoutX      Int
  layoutY      Int
  layoutW      Int
  layoutH      Int
  sortOrder    Int                  @default(0)
  options      Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Notification {
  id        String            @id @default(cuid())
  org       Org               @relation(fields: [orgId], references: [id])
  orgId     String
  user      User?             @relation(fields: [userId], references: [id])
  userId    String?
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@index([orgId, userId, readAt])
}

enum DashboardWidgetType {
  line
  bar
  pie
  scatter
  kline
  radar
  table
}

enum NotificationType {
  crawl_completed
  crawl_failed
  analysis_completed
  analysis_failed
  org_invite
  alert_triggered
  system
}

model AlertNotificationChannel {
  id          String               @id @default(cuid())
  org         Org                  @relation(fields: [orgId], references: [id])
  orgId       String
  type        AlertChannelType
  name        String
  target      String
  config      Json?
  isActive    Boolean              @default(true)
  createdBy   User?                @relation("AlertChannelCreatedBy", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  deliveries  AlertDelivery[]
  ruleLinks   AlertRuleChannel[]

  @@index([orgId, type])
}

model AlertRule {
  id               String           @id @default(cuid())
  org              Org              @relation(fields: [orgId], references: [id])
  orgId            String
  name             String
  description      String?
  severity         AlertSeverity    @default(medium)
  status           AlertStatus      @default(active)
  metricProvider   AlertMetricProvider @default(economic_data)
  dataItem         EconomicDataItem? @relation(fields: [dataItemId], references: [id])
  dataItemId       String?
  metricSlug       String
  operator         AlertOperator
  thresholdValue   Decimal?         @db.Decimal(38, 12)
  thresholdLower   Decimal?         @db.Decimal(38, 12)
  thresholdUpper   Decimal?         @db.Decimal(38, 12)
  changeWindowMin  Int?             // rolling window in minutes
  cooldownSeconds  Int              @default(3600)
  checkIntervalSec Int              @default(300)
  lastTriggeredAt  DateTime?
  metadata         Json?
  createdBy        User?            @relation("AlertRuleCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  events           AlertEvent[]
  channels         AlertRuleChannel[]

  @@index([orgId, status, severity])
}

model AlertEvent {
  id             String              @id @default(cuid())
  rule           AlertRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId         String
  triggeredAt    DateTime
  metricValue    Decimal             @db.Decimal(38, 12)
  changePercent  Float?
  severity       AlertSeverity
  status         AlertEventStatus    @default(pending)
  message        String?
  context        Json?
  createdAt      DateTime            @default(now())

  deliveries     AlertDelivery[]
}

model AlertDelivery {
  id             String                  @id @default(cuid())
  event          AlertEvent              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  channel        AlertNotificationChannel? @relation(fields: [channelId], references: [id])
  channelId      String?
  channelType    AlertChannelType
  targetSnapshot Json?
  status         AlertDeliveryStatus     @default(pending)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime                @default(now())
}

model AlertRuleChannel {
  id         String                   @id @default(cuid())
  rule       AlertRule                @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId     String
  channel    AlertNotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId  String
  createdAt  DateTime                 @default(now())

  @@unique([ruleId, channelId])
}

enum AlertChannelType {
  email
  webhook
}

enum AlertSeverity {
  low
  medium
  high
}

enum AlertStatus {
  draft
  active
  paused
  archived
}

enum AlertMetricProvider {
  economic_data
  system_event
  pipeline_job
  crawl_task
  system_metric
}

enum AlertOperator {
  gt
  gte
  lt
  lte
  eq
  outside_range
  within_range
  change_up_pct
  change_down_pct
}

enum AlertEventStatus {
  pending
  delivered
  failed
}

enum AlertDeliveryStatus {
  pending
  sent
  failed
}

enum MongoOutboxStatus {
  pending
  processing
  failed
}

enum AuditLogOutboxStatus {
  pending
  processing
  failed
  dead
}

enum MongoOutboxType {
  processed_item
  cleanup_crawl_results
}

enum NewsSourceType {
  general
  finance
  technology
  politics
  regulatory
  other
}

enum PipelineJobStatus {
  pending
  queued
  running
  completed
  failed
  delayed
}

model RefreshToken {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  tokenHash   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?

  @@index([userId])
}

enum EconomicDataValueType {
  price
  index
  percent
  yield
  fx
  volume
  quantity
  spread
}

enum EconomicDataFrequency {
  realtime
  hourly
  daily
  weekly
  monthly
}

enum EconomicDataRunStatus {
  pending
  running
  success
  failed
}

model EconomicCategory {
  id          String                  @id @default(cuid())
  key         String                  @unique
  label       String
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  items       EconomicDataItemCategory[]
}

model EconomicDataItem {
  id               String                     @id @default(cuid())
  slug             String                     @unique
  displayName      String
  groupLabel       String?
  description      String?
  sourceFunction   String
  sourceEndpoint   String
  sourceDocUrl     String?
  valueType        EconomicDataValueType      @default(price)
  defaultUnit      String?
  defaultFrequency EconomicDataFrequency      @default(daily)
  responseAdapter  String?
  isActive         Boolean                    @default(true)
  metadata         Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  dataPoints       EconomicDataPoint[]
  fetchConfig      EconomicDataFetchConfig?
  categories       EconomicDataItemCategory[]
  alertRules       AlertRule[]
}

model EconomicDataItemCategory {
  id          String               @id @default(cuid())
  item        EconomicDataItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  category    EconomicCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  createdAt   DateTime             @default(now())

  @@unique([itemId, categoryId])
}

model EconomicDataPoint {
  id          String                @id @default(cuid())
  item        EconomicDataItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  recordedAt  DateTime
  dataType    EconomicDataValueType
  value       Decimal               @db.Decimal(38, 12)
  unit        String?
  sourceField String
  sourceMeta  Json?
  createdAt   DateTime              @default(now())

  @@index([itemId, recordedAt])
  @@unique([itemId, recordedAt, sourceField])
}

model EconomicDataFetchConfig {
  id           String                @id @default(cuid())
  item         EconomicDataItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String                @unique
  frequency    EconomicDataFrequency
  repeatCron   String?
  isEnabled    Boolean               @default(true)
  lastRunAt    DateTime?
  lastStatus   EconomicDataRunStatus?
  lastError    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}
