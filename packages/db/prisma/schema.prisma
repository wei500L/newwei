// Prisma schema for primary MySQL storage
// TODO(db): consider sharding strategies once multi-tenant scale is required.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Org {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  roles       Role[]
  auditLogs   AuditLog[]
  items       ItemMeta[]
  crawlTasks  CrawlTask[]
  newsSources NewsSource[]
  pipelineJobs PipelineJob[]
  articles    Article[]
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  firstName     String
  lastName      String
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  memberships   Membership[]
  auditLogs     AuditLog[]
  refreshTokens  RefreshToken[]
  crawlTasks     CrawlTask[] @relation("CrawlTaskCreatedBy")
}

model Role {
  id          String        @id @default(cuid())
  name        String
  description String?
  org         Org           @relation(fields: [orgId], references: [id])
  orgId       String
  permissions RolePermission[]
  memberships Membership[]

  @@unique([orgId, name])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id            String      @id @default(cuid())
  role          Role        @relation(fields: [roleId], references: [id])
  roleId        String
  permission    Permission  @relation(fields: [permissionId], references: [id])
  permissionId  String

  @@unique([roleId, permissionId])
}

model Membership {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id])
  userId    String
  org       Org    @relation(fields: [orgId], references: [id])
  orgId     String
  role      Role   @relation(fields: [roleId], references: [id])
  roleId    String
  createdAt DateTime @default(now())

  @@unique([userId, orgId])
}

model AuditLog {
  id         String   @id @default(cuid())
  org        Org      @relation(fields: [orgId], references: [id])
  orgId      String
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  resource   String
  action     String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model ItemMeta {
  id          String   @id @default(cuid())
  org         Org      @relation(fields: [orgId], references: [id])
  orgId       String
  externalId  String   @unique
  name        String
  status      String   @default("draft")
  mongoRef    String   // references packages/mongo RawItem document id
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CrawlTask {
  id             String           @id @default(cuid())
  org            Org              @relation(fields: [orgId], references: [id])
  orgId          String
  createdBy      User             @relation("CrawlTaskCreatedBy", fields: [createdById], references: [id])
  createdById    String
  targetUrl      String
  displayName    String?
  status         CrawlTaskStatus  @default(pending)
  config         Json?
  timeRangeFrom  DateTime?
  timeRangeTo    DateTime?
  concurrency    Int              @default(1)
  keywords       Json?
  lastRunAt      DateTime?
  lastSuccessAt  DateTime?
  lastResultAt   DateTime?
  lastCursor     String?
  lastError      String?
  runCount       Int              @default(0)
  lastServerMemoryMb    Float?
  lastPeakMemoryMb      Float?
  lastMemoryEfficiency  Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  results        CrawlResult[]
}

model CrawlResult {
  id          String     @id @default(cuid())
  task        CrawlTask  @relation(fields: [taskId], references: [id])
  taskId      String
  sourceUrl   String
  fetchedAt   DateTime
  markdownRef String
  contentHash String
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([taskId, fetchedAt])
  @@unique([taskId, contentHash])
}

enum CrawlTaskStatus {
  pending
  queued
  running
  completed
  failed
  paused
}

model NewsSource {
  id               String          @id @default(cuid())
  org              Org             @relation(fields: [orgId], references: [id])
  orgId            String
  name             String
  url              String
  siteType         NewsSourceType  @default(general)
  language         String?
  frequencySeconds Int             @default(3600)
  priority         Int             @default(0)
  isActive         Boolean         @default(true)
  config           Json?
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  jobs     PipelineJob[]
  articles Article[]

  @@unique([orgId, url])
}

model PipelineJob {
  id           String            @id @default(cuid())
  org          Org               @relation(fields: [orgId], references: [id])
  orgId        String
  source       NewsSource?       @relation(fields: [sourceId], references: [id])
  sourceId     String?
  url          String
  priority     Int               @default(0)
  status       PipelineJobStatus @default(pending)
  queueName    String            @default("crawl-queue")
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  attempts     Int               @default(0)
  error        String?
  crawlRunId   String?
  article      Article?          @relation(fields: [articleId], references: [id])
  articleId    String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([orgId, status])
  @@index([queueName, status])
  @@index([sourceId, createdAt])
}

model Article {
  id          String        @id @default(cuid())
  org         Org           @relation(fields: [orgId], references: [id])
  orgId       String
  source      NewsSource?   @relation(fields: [sourceId], references: [id])
  sourceId    String?
  url         String
  sourceLabel String?
  language    String?
  titleGuess  String?
  crawlAt     DateTime
  contentHash String        @unique
  markdownRef String?
  version     Int           @default(1)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  jobs      PipelineJob[]
  processed ProcessedArticle?

  @@unique([url, contentHash])
  @@index([orgId, sourceId, crawlAt])
}

model ProcessedArticle {
  id                 String   @id @default(cuid())
  article            Article  @relation(fields: [articleId], references: [id])
  articleId          String   @unique
  title              String?
  subtitle           String?
  author             String?
  source             String?
  publishedAt        DateTime?
  category           String?
  topics             Json?
  summary            String?
  keyPoints          Json?
  entities           Json?
  cleanedMarkdownRef String?
  removedNoiseTypes  Json?
  qualityScore       Float?
  llmModel           String?
  llmPromptVersion   String?
  language           String?
  location           String?
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  costUsd            Float?
  latencyMs          Int?
  createdAt          DateTime @default(now())
  processedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum NewsSourceType {
  general
  finance
  technology
  politics
  regulatory
  other
}

enum PipelineJobStatus {
  pending
  queued
  running
  completed
  failed
  delayed
}

model RefreshToken {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  tokenHash   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?

  @@index([userId])
}

enum EconomicDataValueType {
  price
  index
  percent
  yield
  fx
  volume
  quantity
  spread
}

enum EconomicDataFrequency {
  realtime
  hourly
  daily
  weekly
  monthly
}

enum EconomicDataRunStatus {
  pending
  running
  success
  failed
}

model EconomicCategory {
  id          String                  @id @default(cuid())
  key         String                  @unique
  label       String
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  items       EconomicDataItemCategory[]
}

model EconomicDataItem {
  id               String                     @id @default(cuid())
  slug             String                     @unique
  displayName      String
  groupLabel       String?
  description      String?
  sourceFunction   String
  sourceEndpoint   String
  sourceDocUrl     String?
  valueType        EconomicDataValueType      @default(price)
  defaultUnit      String?
  defaultFrequency EconomicDataFrequency      @default(daily)
  responseAdapter  String?
  isActive         Boolean                    @default(true)
  metadata         Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  dataPoints       EconomicDataPoint[]
  fetchConfig      EconomicDataFetchConfig?
  categories       EconomicDataItemCategory[]
}

model EconomicDataItemCategory {
  id          String               @id @default(cuid())
  item        EconomicDataItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  category    EconomicCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  createdAt   DateTime             @default(now())

  @@unique([itemId, categoryId])
}

model EconomicDataPoint {
  id          String                @id @default(cuid())
  item        EconomicDataItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  recordedAt  DateTime
  dataType    EconomicDataValueType
  value       Decimal               @db.Decimal(38, 12)
  unit        String?
  sourceField String
  sourceMeta  Json?
  createdAt   DateTime              @default(now())

  @@index([itemId, recordedAt])
  @@unique([itemId, recordedAt, sourceField])
}

model EconomicDataFetchConfig {
  id           String                @id @default(cuid())
  item         EconomicDataItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String                @unique
  frequency    EconomicDataFrequency
  repeatCron   String?
  isEnabled    Boolean               @default(true)
  lastRunAt    DateTime?
  lastStatus   EconomicDataRunStatus?
  lastError    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}
