{
  "name": "@modular/db",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "prisma"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "tsx src/scripts/generate.ts"
  },
  "dependencies": {
    "@modular/utils": "workspace:*",
    "bcrypt": "^5.1.1"
  },
  "peerDependencies": {
    "@prisma/client": "^5.16.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.16.0",
    "prisma": "^5.16.0",
    "tslib": "^2.6.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  }
}
