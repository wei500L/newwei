{
  "name": "@modular/db",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "migrate": "tsx src/scripts/migrate.ts",
    "validate:migration-identifiers": "tsx src/scripts/validate-migration-identifiers.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "pnpm run validate:migration-identifiers && eslint src --ext .ts",
    "test": "tsx --test src/**/*.spec.ts",
    "prisma:generate": "tsx src/scripts/generate.ts"
  },
  "dependencies": {
    "@modular/config": "workspace:*",
    "@modular/utils": "workspace:*",
    "bcrypt": "^5.1.1",
    "dayjs": "^1.11.13"
  },
  "peerDependencies": {
    "@prisma/client": "^5.16.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@prisma/client": "^5.16.0",
    "prisma": "^5.16.0",
    "tslib": "^2.6.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  }
}
