# Primary relational datasource for host-side Prisma/API runtime.
# Optional: if set, it overrides MYSQL_* for app runtime and db scripts.
DATABASE_URL=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DB=app

# Required for `pnpm db:seed` (bootstrap org + admin)
SEED_ORG_SLUG=
SEED_ORG_NAME=
SEED_ORG_DESCRIPTION=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
# If Docker MongoDB is published on a non-default host port, keep this URI in sync.
MONGO_URI=mongodb://root:secret@localhost:27017/app?authSource=admin
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_AUTO_INDEX=true
MONGO_BUFFER_COMMANDS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLE_AUTO_PIPELINING=true
REDIS_MAX_RETRIES_PER_REQUEST=3
# Redis 限流降级策略：false=Redis 故障时拒绝请求（fail-closed，防登录/抓取/RBAC 限流被绕过）；true=故障时放行（不推荐）
RATE_LIMIT_REDIS_FAIL_OPEN=false
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT_SECONDS=10
PRISMA_TRANSACTION_MAX_WAIT_MS=5000
PRISMA_TRANSACTION_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_ENABLED=true
HTTP_AGENT_MAX_SOCKETS=64
HTTP_AGENT_MAX_FREE_SOCKETS=16
HTTP_AGENT_TIMEOUT_MS=60000
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wei500l@163.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Wei <wei500l@163.com>"
# REQUIRED: generate with `openssl rand -hex 32`. Startup/env:check fail fast
# until a real (non-placeholder) value is set.
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_GRAPHQL_APQ_ENABLED=true
NEXT_PUBLIC_LLM_GATEWAY_DEFAULT_API_BASE=http://localhost:4001
NODE_ENV=development
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_DEPTH_LIMIT=8
GRAPHQL_COMPLEXITY_LIMIT=2000
GRAPHQL_APQ_ENABLED=true
GRAPHQL_RESPONSE_CACHE_ENABLED=true
GRAPHQL_RESPONSE_CACHE_MAX_AGE_SECONDS=30
# CORS origin allowlist (comma-separated). REQUIRED in production: without
# it the API refuses to start. Must match the browser-facing web origin(s).
CORS_ORIGIN=http://localhost:3000
# WebSocket security (Socket.IO)
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_PER_IP=50
WS_CONNECT_RATE_LIMIT_PER_IP=60
WS_CONNECT_RATE_LIMIT_PER_USER=30
WS_CONNECT_RATE_LIMIT_WINDOW_SECONDS=60
# WebSocket scaling (Socket.IO Redis adapter)
WS_REDIS_ADAPTER_ENABLED=true
WS_REDIS_ADAPTER_KEY=socket.io
# Rate limit defaults (admin UI overrides at runtime)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_CRAWL_TASK_CREATE=10
RATE_LIMIT_CRAWL_TASK_CREATE_WINDOW=300
RATE_LIMIT_RBAC_WRITE=20
RATE_LIMIT_RBAC_WRITE_WINDOW=600
# Observability client exception ingest limits (per configurable window)
# - User scope key: observability:client-exception:user:{orgId}:{userId}
# - IP scope key: observability:client-exception:ip:{orgId}:{ip}
# - Window controls both user/ip buckets; keep it aligned with dashboard alert windows.
OBSERVABILITY_CLIENT_EXCEPTION_USER_RATE_LIMIT=30
OBSERVABILITY_CLIENT_EXCEPTION_IP_RATE_LIMIT=120
OBSERVABILITY_CLIENT_EXCEPTION_RATE_LIMIT_WINDOW_SECONDS=60
OTEL_ENABLED=false
OTEL_SERVICE_NAME=modular-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATE=0.05
RATE_LIMIT_SETTINGS_CACHE_TTL_SECONDS=60
AUTH_PROFILE_CACHE_TTL_SECONDS=600
AUTH_PROFILE_CACHE_LOCK_TTL_MS=5000
AUTH_PROFILE_CACHE_MAX_WAIT_MS=5000
AUTH_PROFILE_CACHE_RETRY_DELAY_MS=50
AUTH_REFRESH_GRACE_SECONDS=10
AUTH_EMAIL_CODE_TTL_SECONDS=300
AUTH_EMAIL_CODE_COOLDOWN_SECONDS=90
AUTH_EMAIL_CODE_MAX_ATTEMPTS=3
AUTH_MFA_CHALLENGE_MAX_ATTEMPTS=5
AUDIT_LOG_RETENTION_DAYS=90
TASK_LOG_RETENTION_DAYS=14
CRAWL4AI_BASE_URL=http://localhost:8082
# Optional: browser-accessible crawl4ai dashboard URL (defaults to CRAWL4AI_BASE_URL + /dashboard/)
CRAWL4AI_DASHBOARD_URL=http://localhost:8082/dashboard/
CRAWL4AI_API_KEY=
CRAWL4AI_TIMEOUT_MS=120000
CRAWL4AI_MAX_CONCURRENCY=3
CRAWL4AI_MAX_RETRIES=3
CRAWL4AI_HEALTH_CHECK_TTL_MS=60000
CRAWL4AI_RETRY_BACKOFF_MS=5000
# When using the bundled Docker crawl4ai service, keep this pointed at the worker-local SSRF proxy.
# The Crawl4AI monitor page uses this to report SSRF proxy status and risk level.
CRAWL4AI_SSRF_PROXY_URL=http://127.0.0.1:18080
# Crawl task janitor (stale task cleanup)
CRAWL_TASK_JANITOR_ENABLED=true
CRAWL_TASK_RUNNING_TIMEOUT_MS=1800000
CRAWL_TASK_QUEUED_TIMEOUT_MS=43200000
CRAWL_TASK_JANITOR_BATCH_SIZE=50
CRAWL_TASK_JANITOR_QUEUE_SCAN_LIMIT=5000
CRAWL_TASK_JANITOR_LOCK_TTL_MS=120000
CRAWL_MEDIA_FETCH_TIMEOUT_MS=15000
CRAWL_MEDIA_MAX_BYTES=2097152
CRAWL_MEDIA_MAX_PER_RESULT=6
# Bootstrap defaults only; runtime completion/embedding/rerank model routing is read from
# Settings -> LLM gateway profiles stored in MySQL.
LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LITELLM_API_BASE=http://localhost:4001
LITELLM_API_KEY=
LITELLM_TIMEOUT_MS=60000
LITELLM_TEMPERATURE=0.2
LITELLM_TOP_P=0.9
LITELLM_MAX_OUTPUT_TOKENS=1200
LITELLM_MAX_RETRIES=3
LITELLM_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-3-haiku
LITELLM_REQUESTS_PER_MINUTE=60
ITEMS_SEARCH_RERANK_ENABLED=true
ITEMS_SEARCH_RECALL_MAX_CANDIDATES=120
ITEMS_SEARCH_RERANK_MAX_CANDIDATES=40
ITEMS_SEARCH_RERANK_TIMEOUT_MS=300
ITEMS_SEARCH_RECENCY_HALFLIFE_HOURS=48
# Optional: allow LiteLLM Proxy container to fetch OpenAI keys from API (stored in MySQL)
# - Used by infra/litellm/generate-litellm-config.py
# - If set, also set the same value in infra/docker/.env for docker-compose
# - Web app does NOT need this token (organization switch error reporting uses user JWT).
LITELLM_CONFIG_INTERNAL_TOKEN=
# Optional: override API base used for key fetch. For Docker Compose with Nest global prefix, use /api.
LITELLM_CONFIG_API_BASE=http://api:4000/api
# Assistant content safety (LiteLLM Proxy guardrails)
# - Requires LiteLLM proxy to define these guardrails in its config.yaml (`guardrails:`).
# - Comma-separated guardrail names (e.g. openai-moderation-pre,azure-prompt-shield).
ASSISTANT_GUARDRAILS_ENABLED=true
ASSISTANT_GUARDRAILS=openai-moderation-pre
# Vector service (optional, used for semantic search/dedupe)
VECTOR_SERVICE_ENABLED=false
VECTOR_SERVICE_FALLBACK_TO_MONGO=true
VECTOR_SERVICE_BASE_URL=http://localhost:4010
VECTOR_INTERNAL_TOKEN=dev-token
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_COLLECTION_PREFIX=processed_item_summary
# Model service (optional, used for time-series anomaly forecasting)
MODEL_SERVICE_ENABLED=true
MODEL_SERVICE_BASE_URL=http://localhost:8090
MODEL_SERVICE_INTERNAL_TOKEN=dev-model-token
MODEL_SERVICE_TIMEOUT_MS=15000
MODEL_SERVICE_MAX_RETRIES=2
# Akshare gateway is optional. Set to true only when the gateway is running.
AKSHARE_ENABLED=false
AKSHARE_HTTP_BASE_URL=http://localhost:8081
AKSHARE_HTTP_TIMEOUT_MS=20000
AKSHARE_HTTP_MAX_RETRIES=3
AKSHARE_ADMIN_TOKEN=
# Situation Monitor external data sources (optional)
SITUATION_MONITOR_GDELT_ENABLED=true
SITUATION_MONITOR_TRANSLATION_API_ENABLED=true
SITUATION_MONITOR_TRANSLATION_API_BASE_URL=https://api.deeplx.org
SITUATION_MONITOR_TRANSLATION_TIMEOUT_MS=15000
SITUATION_MONITOR_TRANSLATION_MAX_RETRIES=2
SITUATION_MONITOR_TRANSLATION_FALLBACK_API_ENABLED=false
SITUATION_MONITOR_TRANSLATION_FALLBACK_API_BASE_URL=
# Situation Monitor live HLS proxy is configured in MySQL (System Settings -> Situation Monitor)
REALTIME_SIGNALS_ENABLED=true
REALTIME_SIGNALS_REQUEST_TIMEOUT_MS=12000
REALTIME_SIGNALS_MAX_RETRIES=2
# OpenSky military snapshot ingestion is the canonical flight source.
REALTIME_SIGNALS_OPENSKY_ENABLED=true
REALTIME_SIGNALS_OPENSKY_INTERVAL_SEC=900
REALTIME_SIGNALS_OPENSKY_DAILY_CREDIT_BUDGET=4000
REALTIME_SIGNALS_OPENSKY_DAY_INTERVAL_SEC=600
REALTIME_SIGNALS_OPENSKY_NIGHT_INTERVAL_SEC=1800
REALTIME_SIGNALS_OPENSKY_DAY_START_HKT=8
REALTIME_SIGNALS_OPENSKY_NIGHT_START_HKT=22
REALTIME_SIGNALS_OPENSKY_WARNING_REMAINING_PCT=20
REALTIME_SIGNALS_OPENSKY_CRITICAL_REMAINING_PCT=10
# Legacy ADS-B aliases are read for backward compatibility only.
REALTIME_SIGNALS_ADSB_ENABLED=
REALTIME_SIGNALS_ADSB_INTERVAL_SEC=
REALTIME_SIGNALS_AIS_ENABLED=true
REALTIME_SIGNALS_AIS_INTERVAL_SEC=600
REALTIME_SIGNALS_UNREST_ENABLED=true
REALTIME_SIGNALS_UNREST_INTERVAL_SEC=600
REALTIME_SIGNALS_OUTAGES_ENABLED=true
REALTIME_SIGNALS_OUTAGES_INTERVAL_SEC=600
REALTIME_SIGNALS_KEYWORD_SPIKE_ENABLED=true
REALTIME_SIGNALS_KEYWORD_SPIKE_INTERVAL_SEC=600
REALTIME_SIGNALS_PIZZINT_ENABLED=true
REALTIME_SIGNALS_PIZZINT_INTERVAL_SEC=600
REALTIME_SIGNALS_GDELT_TENSION_ENABLED=true
REALTIME_SIGNALS_GDELT_TENSION_INTERVAL_SEC=600
REALTIME_SIGNALS_POLYMARKET_LEADS_ENABLED=true
REALTIME_SIGNALS_POLYMARKET_LEADS_INTERVAL_SEC=600
REALTIME_SIGNALS_KEYWORD_SPIKE_MIN_COUNT=5
REALTIME_SIGNALS_KEYWORD_SPIKE_MULTIPLIER=3
REALTIME_SIGNALS_PREDICTION_SHIFT_THRESHOLD=5
REALTIME_SIGNALS_PREDICTION_NEWS_ACTIVITY_THRESHOLD=3
# Realtime signals / AIS relay (local dev)
# API requests: ${REALTIME_SIGNALS_AIS_BASE_URL}/ais/snapshot
# REALTIME_SIGNALS_AIS_SHARED_SECRET must match AIS_RELAY_SHARED_SECRET.
# `/health` returns HTTP 200 even when degraded. Docker healthcheck reads
# the JSON `status` field and only treats `ok` as healthy.
AIS_RELAY_PORT=3004
REALTIME_SIGNALS_AIS_BASE_URL=http://localhost:3004
REALTIME_SIGNALS_AIS_SHARED_SECRET=change_me_generate_a_long_random_secret
AIS_RELAY_SHARED_SECRET=change_me_generate_a_long_random_secret
# Optional custom upstream for smoke tests or internal proxying.
# Defaults to the public AISStream websocket endpoint when unset.
# Prefer this key over the legacy alias `AIS_RELAY_UPSTREAM_URL`.
AISSTREAM_URL=
# REQUIRED: the ais-relay refuses to start without this key
AISSTREAM_API_KEY=change-me-aisstream-api-key
# Relay health will degrade if no upstream message arrives within this window
# after a websocket connection is established.
AIS_RELAY_HEALTH_NO_MESSAGES_AFTER_CONNECT_MS=60000
# Relay health will degrade if the websocket stays open but message flow stalls
# for longer than this window.
AIS_RELAY_HEALTH_STALE_MESSAGES_MS=90000
# Advanced thresholds for normalization / parse-failure based degradation.
AIS_RELAY_HEALTH_MIN_POSITION_REPORTS=25
AIS_RELAY_HEALTH_MAX_IGNORED_RATIO_PERCENT=85
AIS_RELAY_HEALTH_MAX_PARSE_ERROR_RATIO_PERCENT=20
# OpenSky REST API + OAuth2 client credentials.
REALTIME_SIGNALS_OPENSKY_BASE_URL=https://opensky-network.org/api
REALTIME_SIGNALS_OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
REALTIME_SIGNALS_OPENSKY_CLIENT_ID=
REALTIME_SIGNALS_OPENSKY_CLIENT_SECRET=
# Legacy alias for the old ADS-B base URL setting.
REALTIME_SIGNALS_ADSB_BASE_URL=
REALTIME_SIGNALS_ACLED_USERNAME=
REALTIME_SIGNALS_ACLED_PASSWORD=
REALTIME_SIGNALS_ACLED_CLIENT_ID=acled
REALTIME_SIGNALS_CLOUDFLARE_API_TOKEN=
REALTIME_SIGNALS_WINGBITS_API_KEY=
REALTIME_SIGNALS_POLYMARKET_PROXY_URL=
SITUATION_MONITOR_TELEGRAM_ENABLED=false
SITUATION_MONITOR_TELEGRAM_API_ID=
SITUATION_MONITOR_TELEGRAM_API_HASH=
SITUATION_MONITOR_TELEGRAM_CHANNEL_SET=full
SITUATION_MONITOR_TELEGRAM_MAX_FEED_ITEMS=200
SITUATION_MONITOR_TELEGRAM_MAX_TEXT_CHARS=800
SITUATION_MONITOR_TELEGRAM_CHANNEL_TIMEOUT_MS=15000
SITUATION_MONITOR_TELEGRAM_POLL_CYCLE_TIMEOUT_MS=180000
SITUATION_MONITOR_TELEGRAM_STARTUP_DELAY_MS=60000
SITUATION_MONITOR_TELEGRAM_RATE_LIMIT_MS=800
SITUATION_MONITOR_TELEGRAM_POLL_INTERVAL_MS=60000
SITUATION_MONITOR_OREF_ENABLED=false
SITUATION_MONITOR_OREF_PROXY_AUTH=
SITUATION_MONITOR_OREF_ALERTS_URL=https://www.oref.org.il/WarningMessages/alert/alerts.json
SITUATION_MONITOR_OREF_HISTORY_URL=https://www.oref.org.il/WarningMessages/alert/History/AlertsHistory.json
SITUATION_MONITOR_OREF_HISTORY_RETENTION_DAYS=7
SITUATION_MONITOR_OREF_HISTORY_MAX_WAVES=200
SITUATION_MONITOR_OREF_CURL_TIMEOUT_SEC=15
SITUATION_MONITOR_OREF_BOOTSTRAP_MAX_RETRIES=3
SITUATION_MONITOR_OREF_POLL_INTERVAL_MS=300000
NEWS_PIPELINE_CACHE_TTL_SECONDS=3600
NEWS_PIPELINE_MAX_INPUT_CHARS=48000
NEWS_PIPELINE_CONFIG_PATH=config/news-pipeline.config.yaml
NEWS_SOURCE_SCHEDULER_ENABLED=true
NEWS_SOURCE_SCHEDULER_BATCH_SIZE=20
NEWS_SOURCE_SCHEDULER_LOCK_TTL_MS=120000
NEWS_SOURCE_SCHEDULER_INFLIGHT_LOOKBACK_MS=21600000
NEWS_SOURCE_SCHEDULER_INFLIGHT_RESCHEDULE_DELAY_MS=300000
# Jitter: spreads nextRunAt to avoid herd scheduling at exact boundaries.
NEWS_SOURCE_SCHEDULER_JITTER_MAX_MS=60000
# Max number of CrawlTasks enqueued per scheduler tick (0 = unlimited).
NEWS_SOURCE_SCHEDULER_MAX_ENQUEUE_PER_TICK=100
# Backpressure: delay due sources when crawl4ai queue backlog is high.
NEWS_SOURCE_CRAWL_QUALITY_PROFILE=quality_first
NEWS_SOURCE_CRAWL_AUTO_EXPAND_DETAILS=true
NEWS_SOURCE_CRAWL_DETAIL_MAX_URLS=12
NEWS_SOURCE_CRAWL_DETAIL_MIN_RELEVANCE_SCORE=0.35
NEWS_SOURCE_CRAWL_DETAIL_REQUIRE_SAME_DOMAIN=true
NEWS_SOURCE_SCHEDULER_BACKPRESSURE_MAX_PENDING_JOBS=100
NEWS_SOURCE_SCHEDULER_BACKPRESSURE_DELAY_MS=300000
NEWS_SOURCE_SCHEDULER_FAILURE_RECOVERY_DELAY_MS=600000
NEWS_SOURCE_SCHEDULER_FAILURE_MAX_DELAY_MS=21600000
NEWS_SOURCE_SCHEDULER_CIRCUIT_BREAKER_THRESHOLD=3
NEWS_SOURCE_SCHEDULER_CIRCUIT_BREAKER_BASE_DELAY_MS=3600000
NEWS_SOURCE_SCHEDULER_CIRCUIT_BREAKER_MAX_DELAY_MS=86400000
# Auto-disable a source after N consecutive failures (0 = disabled).
NEWS_SOURCE_SCHEDULER_AUTO_DISABLE_THRESHOLD=0
# Encrypts stored secrets (OIDC client secret, TOTP, LLM/vector/model keys, news source runtime secrets, etc.).
# REQUIRED in production: without it the API rejects writing secrets (fail-closed); non-production falls back to plaintext.
# Generate with: openssl rand -hex 32
SYSTEM_SETTINGS_ENCRYPTION_KEY=
# MinIO (local S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 storage (defaults to MinIO if running locally)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=modular-avatars
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/modular-avatars
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=300

# Bull Board (disabled by default, RBAC-guarded when enabled)
# Requires BULL_BOARD_ENABLED=true and a JWT carrying the queue.manage permission.
BULL_BOARD_ENABLED=false
