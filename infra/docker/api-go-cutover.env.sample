# ============================================================================
# api-go 切流配置样例（api-go-cutover.env.sample）
# ============================================================================
#
# 性质与边界（务必先读完）：
#   1. 本文件仅用于「Go 切流演练 / 部署参考」，不是生产默认配置。
#   2. 不被 docker-compose.yml 默认加载：compose 没有引用本文件名；不执行
#      --env-file 或复制到 .env 时，它对任何服务都没有影响。
#   3. 不改变任何现有默认值：本批只新增本文件，没有修改 docker-compose.yml、
#      infra/docker/.env.sample、config.go 或任何开关默认值。
#   4. 复制/合并到部署环境后使用；文件内所有尖括号 <...> 都是占位符，必须替换，
#      严禁把真实密钥写回仓库。
#   5. 本文件是「终态」样例：131 个 API_GO_* 全部为 go。分阶段演练时，请按
#      docs/refactor/cutover/runbook.md 只保留当前阶段的 go，其余先改回 legacy。
#
# 覆盖范围（与 apps/api-go/internal/config/config.go 的 getenv 调用逐一核对）：
#   - 131 个 API_GO_* 开关，全部唯一、无遗漏；权威名单可用
#     grep -o 'getenv("API_GO_[A-Z0-9_]*")' apps/api-go/internal/config/config.go | sort -u
#     复核（应为 131 行）。
#   - 配合项：Web 入口（运行期 / 构建期）、Socket.IO 路径、GraphQL bus、
#     WS Redis adapter、资源连接串占位符、外部服务变量。
#
# 分阶段分组：按 runbook 的阶段 0-6 分节，每节标题带阶段编号。阶段归属与
# docs/refactor/cutover/switch-matrix.md（T3）一致：阶段 1=36、2=61、3=18、4=12、5=3、6=1；
# 阶段 0 不翻转任何开关（只改 Web 入口）。
#
# ⚠ 生效性（本批静态核对，未在部署环境验证）：
#   compose 的 api-go 服务对 API_GO_* 的接线分三类：
#     - 71 个通过 ${VAR:-legacy} 插值：--env-file / .env 可以覆盖；
#     - 49 个写死字面量：其中 7 个固定 go、42 个固定 legacy，env 无法覆盖；
#     - 10 个完全没有注入（api-go 没有 env_file）：env 也无法注入。
#   → 仅用 --env-file 只能影响 130 个 compose 接线中的 71 个；本批新增的
#     API_GO_CRAWL_FRONTIER_WRITES_MODE 不在 compose 中，随下方 override 的
#     env_file 注入才生效（合并前需复核）。
#   本批已提供配套 override：infra/docker/docker-compose.api-go-cutover.sample.yml
#   （不会被默认加载，需 -f 显式指定）。它在 api-go 服务上加 env_file 注入全部
#   131 个开关 + 资源占位，并把 compose 中 49 个硬编码开关用 ${VAR} 重新声明，
#   从而让 env 文件的值真正生效。参考片段：
#       services:
#         api-go:
#           environment:
#             API_GO_X_MODE: ${API_GO_X_MODE:-legacy}
#   然后用（在仓库根执行；两个 --env-file 缺一不可，--env-file 会替代默认 .env）：
#       docker compose \
#         --env-file infra/docker/.env \
#         --env-file infra/docker/api-go-cutover.env.sample \
#         -f infra/docker/docker-compose.yml \
#         -f infra/docker/docker-compose.api-go-cutover.sample.yml \
#         --profile api-go-pilot up -d
#   注意：--env-file 只影响 compose 插值；api 服务的 env_file: ./.env 仍会加载
#   .env。要让 Nest 侧读到同名开关（46 个双方都读的开关），应把本文件合并进
#   infra/docker/.env，而不是只加 --env-file。具体清单与命令见 runbook §2.2/§3。
#
# 固定 go 的 7 个（即使不传本文件，api-go-pilot 的 api-go 也是 go）：
#   API_GO_DASHBOARD_CHARTS_MODE API_GO_DASHBOARD_STATS_MODE API_GO_DASHBOARD_WAR_MAP_MODE API_GO_ONBOARDING_MODE API_GO_PUBLIC_PORTAL_MODE API_GO_USER_SETTINGS_READ_MODE API_GO_USER_SETTINGS_WRITE_MODE
# 固定 legacy 的 42 个（行尾标 [需 override]）：
#   API_GO_ACCOUNT_SECURITY_MODE
#   API_GO_ADMIN_LOGS_MODE
#   API_GO_ANALYSIS_BOARDS_MODE
#   API_GO_ANALYSIS_EXPORT_MODE
#   API_GO_ANALYSIS_THREADS_MODE
#   API_GO_ANALYSIS_VIEWS_MODE
#   API_GO_ARCHIVE_READING_MODE
#   API_GO_AVATAR_UPLOAD_MODE
#   API_GO_CLASSIFICATION_RSS_OPS_MODE
#   API_GO_CONTENT_SUBSCRIPTIONS_MODE
#   API_GO_CRAWL_METADATA_MODE
#   API_GO_CRAWL_PROFILES_MODE
#   API_GO_CRAWL_QUEUE_OPS_MODE
#   API_GO_CRAWL_READ_TELEMETRY_MODE
#   API_GO_CRAWL_TASK_WRITE_MODE
#   API_GO_CRAWL_TEMPLATES_MODE
#   API_GO_CRAWL_WORKFLOWS_MODE
#   API_GO_EXCEPTION_INGEST_MODE
#   API_GO_GRAPHQL_ALERT_RULES_MODE
#   API_GO_GRAPHQL_CRAWL_METADATA_MODE
#   API_GO_GRAPHQL_ITEMS_LIST_MODE
#   API_GO_GRAPHQL_KG_IMPACT_MODE
#   API_GO_GRAPHQL_KNOWLEDGE_REVIEW_MODE
#   API_GO_GRAPHQL_NEWS_EVENT_BRIEF_MODE
#   API_GO_GRAPHQL_ORG_ACCESS_WRITE_MODE
#   API_GO_GRAPHQL_RSS_TRANSLATION_MODE
#   API_GO_GRAPHQL_SETTINGS_CRAWL_READ_MODE
#   API_GO_GRAPHQL_SETTINGS_WRITE_MODE
#   API_GO_GRAPHQL_SOURCE_POLICY_WRITE_MODE
#   API_GO_GRAPHQL_WORKSPACE_READ_MODE
#   API_GO_GRAPHQL_WORKSPACE_WRITE_MODE
#   API_GO_ITEMS_READING_MODE
#   API_GO_LLM_LOGS_MODE
#   API_GO_NEWSNOW_CLUSTERING_OPS_MODE
#   API_GO_NEWS_INDICATORS_MODE
#   API_GO_NEWS_SOURCES_MODE
#   API_GO_QUALITY_OVERVIEW_MODE
#   API_GO_RUNTIME_SETTINGS_MODE
#   API_GO_SITUATION_MONITORS_MODE
#   API_GO_USER_DATA_EXPORT_MODE
#   API_GO_USER_DIGEST_MODE
#   API_GO_USER_NEWS_BEHAVIOR_MODE
# 完全未注入的 10 个（基线 compose；行尾标 [需 override]）：
#   本批新增的 API_GO_CRAWL_FRONTIER_WRITES_MODE 也不在 compose 中，由 override
#   的 env_file 注入；base compose 的 71/49/10 统计口径不变。
#   API_GO_DASHBOARD_SPACETIME_GEO_MODE
#   API_GO_DASHBOARD_SPACETIME_PROPAGATION_MODE
#   API_GO_DASHBOARD_STREAM_MODE
#   API_GO_DASHBOARD_WAR_MAP_LAYERS_MODE
#   API_GO_DASHBOARD_WAR_MAP_TRANSPORT_MODE
#   API_GO_GRAPHQL_KNOWLEDGE_GRAPH_MODE
#   API_GO_GRAPHQL_NEWS_EVENTS_MODE
#   API_GO_GRAPHQL_READ_MODE
#   API_GO_HEALTHZ_MODE
#   API_GO_RBAC_MODE
#
# 事实基线：worktree 分支 docs/go-cutover-readiness，基线 dcbe563b。
# 行号证据以该提交为准；本文件没有经过 docker compose config 校验（本批禁止执行）。

# ============================================================================
# 通用资源与配合项（不属于阶段分组；缺一项 Go 会在启动时失败）
# ============================================================================
#
# 说明：值里的 <...> 必须替换；主机名/端口按 infra/docker/docker-compose.yml
# 的实际服务名填写。真实密钥只放在部署环境的 .env，不要提交。

# --- api-go 运行期基础 ---
PORT=4020
LEGACY_API_URL=http://api:4000
CANARY_PERCENT=0
TRUST_PROXY=
SCHEDULE_ENABLED=true
BULLMQ_WORKERS_ENABLED=true
BULLMQ_NAMESPACE=modular

# --- 数据库 / 缓存 / 鉴权（config.go 强校验资源）---
# DATABASE_URL 由 Nest 的 MYSQL_* 派生（compose:810）；两边必须指向同一 MySQL。
DATABASE_URL=mysql://<MYSQL_USER>:<MYSQL_PASSWORD>@mysql:3306/<MYSQL_DB>
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_DB=0
MONGO_URI=mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD>@mongo:27017/<MONGO_DB>?authSource=admin
JWT_SECRET=<JWT_SECRET>
JWT_ISSUER=modular-monolith
JWT_AUDIENCE=modular-monolith-clients
SYSTEM_SETTINGS_ENCRYPTION_KEY=<SYSTEM_SETTINGS_ENCRYPTION_KEY>

# --- Web 入口（阶段 0）。API_BASE_URL 是 web 容器运行期读取，改后只需重启 web；
#     NEXT_PUBLIC_API_BASE_URL 是构建期内联，必须重建 web 镜像才生效。---
# 终态（浏览器也经 api-go）：
API_BASE_URL=http://api-go:4020
NEXT_PUBLIC_API_BASE_URL=http://localhost:4020/api
# 阶段 0A 只切服务端入口（无需重建）：API_BASE_URL=http://api-go:4020，
#   NEXT_PUBLIC_API_BASE_URL 保持默认 http://localhost:4000/api。
# 阶段 0B 再切浏览器入口：NEXT_PUBLIC_API_BASE_URL=http://localhost:4020/api，
#   并执行 docker compose build web && docker compose up -d web。
# 回滚：API_BASE_URL=http://api:4000 + 重启 web；浏览器入口改回
#   http://localhost:4000/api 并重建 web。

# --- Socket.IO 两个独立路径（阶段 5，构建期参数）---
# 注意：这两项是 Next.js 构建期内联参数（infra/docker/runtime.Dockerfile:29-32），
# 修改后必须重建 Web 镜像；只重启容器浏览器仍会连 /socket.io。
NEXT_PUBLIC_NOTIFICATIONS_SOCKET_PATH=/socket.io-notifications
NEXT_PUBLIC_REALTIME_SOCKET_PATH=/socket.io-realtime

# --- GraphQL / WS / 队列兼容开关 ---
# API_GO_GRAPHQL_SUBSCRIPTIONS_MODE=go 要求 GRAPHQL_SUBSCRIPTION_BUS=redis（config.go:4213）。
GRAPHQL_SUBSCRIPTION_BUS=redis
# API_GO_REALTIME_SOCKET_MODE=go 要求 WS_REDIS_ADAPTER_ENABLED=true（config.go:6008）。
WS_REDIS_ADAPTER_ENABLED=true
WS_REDIS_ADAPTER_KEY=socket.io

# --- 外部服务（真实验证清单见 runbook §5；本批未执行任何一项）---
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_KEY=<CRAWL4AI_API_KEY>
LITELLM_API_BASE=http://litellm:4000
LITELLM_API_KEY=<LITELLM_API_KEY>
LITELLM_MASTER_KEY=<LITELLM_MASTER_KEY>
MODEL_SERVICE_BASE_URL=http://model-service:8090
MODEL_SERVICE_INTERNAL_TOKEN=<MODEL_SERVICE_INTERNAL_TOKEN>
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_SECURE=true
SMTP_USER=<SMTP_USER>
SMTP_PASS=<SMTP_PASS>
SMTP_FROM=<SMTP_FROM>
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=<S3_BUCKET>
S3_ACCESS_KEY_ID=<S3_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<S3_SECRET_ACCESS_KEY>
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=<S3_PUBLIC_BASE_URL>
SITUATION_MONITOR_TELEGRAM_ENABLED=true
SITUATION_MONITOR_TELEGRAM_API_ID=<TELEGRAM_API_ID>
SITUATION_MONITOR_TELEGRAM_API_HASH=<TELEGRAM_API_HASH>
SITUATION_MONITOR_TELEGRAM_CHANNEL_SET=full
SITUATION_MONITOR_OREF_ENABLED=true
SITUATION_MONITOR_OREF_PROXY_AUTH=<OREF_PROXY_AUTH>
SITUATION_MONITOR_OREF_ALERTS_URL=https://www.oref.org.il/WarningMessages/alert/alerts.json
SITUATION_MONITOR_OREF_HISTORY_URL=https://www.oref.org.il/WarningMessages/alert/History/AlertsHistory.json
GEO_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEO_NOMINATIM_USER_AGENT=<NOMINATIM_USER_AGENT>
GEO_NOMINATIM_EMAIL=<NOMINATIM_EMAIL>
REALTIME_SIGNALS_ENABLED=true
REALTIME_SIGNALS_OPENSKY_ENABLED=true
REALTIME_SIGNALS_OPENSKY_CLIENT_ID=<OPENSKY_CLIENT_ID>
REALTIME_SIGNALS_OPENSKY_CLIENT_SECRET=<OPENSKY_CLIENT_SECRET>
VECTOR_SERVICE_BASE_URL=http://vector:4010
VECTOR_SERVICE_ENABLED=true

# --- compose 插值提示（不要写进本 env 文件）---
# API_GO_HOST_PORT 是 compose 的端口插值变量（默认 4020），不是 api-go 开关；
# 如需改发布端口，在 compose 的 --env-file/.env 里设 API_GO_HOST_PORT，不要写在本文件。
# COMPOSE_PROFILES=api-go-pilot 同理，属于 compose 选择器，不是容器环境变量。

# ============================================================================
# 阶段 1 · 只读 HTTP 与 GraphQL 读
# ============================================================================
#
# --- 1A 低风险只读入口（先开观测，再开业务读） ---
# 先开 API_GO_METRICS_MODE 让 /api/metrics 由 Go 输出，便于后续阶段用真实指标观察；
# 但 note：当前 Go 侧只有 scheduler_runs_total 有记录点，http/队列/集成/管道指标 family 存在但没有 series（见 runbook §6）。
API_GO_METRICS_MODE=go
# [已固定 go] compose 硬编码 go；阶段 0 严格全 legacy 需覆盖
API_GO_PUBLIC_PORTAL_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_ITEMS_READING_MODE=go
API_GO_PIPELINE_RECOVERY_MODE=go
API_GO_SITUATION_INSIGHTS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_QUALITY_OVERVIEW_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_ADMIN_LOGS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_LLM_LOGS_MODE=go
API_GO_RUNTIME_DIAGNOSTICS_MODE=go
API_GO_GEOCODING_MODE=go
#
# --- 1B 仪表盘 / 态势只读 GET ---
# 仪表盘只读 GET。DASHBOARD_STATS 需要 MONGO_URI；CHARTS 不需要 Mongo；其余按 config.go 校验。
# DASHBOARD_STREAM 是 SSE，接管后不再请求 NestJS。
# [已固定 go] compose 硬编码 go；阶段 0 严格全 legacy 需覆盖
API_GO_DASHBOARD_STATS_MODE=go
# [已固定 go] compose 硬编码 go；阶段 0 严格全 legacy 需覆盖
API_GO_DASHBOARD_CHARTS_MODE=go
# [已固定 go] compose 硬编码 go；阶段 0 严格全 legacy 需覆盖
API_GO_DASHBOARD_WAR_MAP_MODE=go
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_DASHBOARD_WAR_MAP_TRANSPORT_MODE=go
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_DASHBOARD_WAR_MAP_LAYERS_MODE=go
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_DASHBOARD_SPACETIME_GEO_MODE=go
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_DASHBOARD_SPACETIME_PROPAGATION_MODE=go
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_DASHBOARD_STREAM_MODE=go
#
# --- 1C 个人 / 设置 / 采集 / 存储只读 ---
# USER_SETTINGS_READ_MODE=go 会同时改变 onboarding/rss/spacetime/war-map/newsnow/situation 六个 GET 的归属（优先于 API_GO_ONBOARDING_MODE）。
# STORAGE_DIAGNOSTICS 是对 S3 连接做 HeadBucket/PutObject/DeleteObject 的只读诊断，失败仍返回 201 + ok:false。
# CRAWL_METADATA 与 NEWS_SOURCE_PREVIEW 是 POST，但不写业务表（只做外部抓取/解析）。
# [已固定 go] compose 硬编码 go；阶段 0 严格全 legacy 需覆盖
API_GO_USER_SETTINGS_READ_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_ARCHIVE_READING_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_ANALYSIS_EXPORT_MODE=go
API_GO_NEWS_SOURCE_PREVIEW_MODE=go
API_GO_NEWSNOW_SOURCES_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CRAWL_METADATA_MODE=go
# [已固定 go] compose 硬编码 go；阶段 0 严格全 legacy 需覆盖
API_GO_ONBOARDING_MODE=go
API_GO_SITUATION_MONITOR_SIGNALS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_USER_DATA_EXPORT_MODE=go
#
# --- 1D GraphQL 读（总开关先开，再逐组登记 root） ---
# 总开关 API_GO_GRAPHQL_READ_MODE=go 只登记本批已迁移 query；未注册 operation 仍整份回退 NestJS。
# 依赖（config.go 强校验）：GRAPHQL_ITEMS_LIST_MODE → GRAPHQL_READ + ITEMS_READING；
# GRAPHQL_CRAWL_METADATA_MODE → GRAPHQL_READ；GRAPHQL_NEWS_EVENT_BRIEF_MODE → GRAPHQL_READ + GRAPHQL_NEWS_EVENTS。
# 注意：compose 当前没有注入 GRAPHQL_READ_MODE / GRAPHQL_NEWS_EVENTS_MODE / GRAPHQL_KNOWLEDGE_GRAPH_MODE，需 override（本文件末尾清单）。
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_GRAPHQL_READ_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_WORKSPACE_READ_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_SETTINGS_CRAWL_READ_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_KG_IMPACT_MODE=go
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_GRAPHQL_KNOWLEDGE_GRAPH_MODE=go
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_GRAPHQL_NEWS_EVENTS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_NEWS_EVENT_BRIEF_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_ITEMS_LIST_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_CRAWL_METADATA_MODE=go

# ============================================================================
# 阶段 2 · 写入类 HTTP 与 GraphQL Mutation
# ============================================================================
#
# --- 2A 设置 / 治理 / 诊断写入 ---
# 设置类写接口复用 MySQL SystemSetting + Redis 缓存；改错会影响全局治理，建议逐组切换、每组后核对 GET 回读。
# EXCEPTION_INGEST 是两个 POST（client 与 LiteLLM internal），只写 Mongo exceptionevents。
API_GO_DATA_RUNTIME_SETTINGS_MODE=go
API_GO_EMAIL_SETTINGS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_RUNTIME_SETTINGS_MODE=go
API_GO_PLATFORM_GOVERNANCE_SETTINGS_MODE=go
API_GO_INFRASTRUCTURE_SETTINGS_MODE=go
API_GO_MODEL_ACCESS_SETTINGS_MODE=go
API_GO_LLM_GATEWAY_PROFILES_MODE=go
API_GO_LLM_GATEWAY_OPS_MODE=go
API_GO_PROXY_LOAD_BALANCING_MODE=go
API_GO_SITUATION_SETTINGS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_EXCEPTION_INGEST_MODE=go
API_GO_STORAGE_DIAGNOSTICS_MODE=go
API_GO_SITUATION_REFRESH_MODE=go
#
# --- 2B 采集写（任务、模板、画像、工作流、队列操作、索引重建） ---
# 采集写只改 MySQL/Redis 元数据；真正的抓取仍由 worker 执行（阶段 4）。
# GDELT_SNAPSHOT_REFRESH 是手动强制刷新入口，定时重建在阶段 3。
# SEARCH_REINDEX 创建重建任务并写 ES；ES 未启用时任务直接 completed/indexed=0。
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CRAWL_TASK_WRITE_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CRAWL_QUEUE_OPS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CRAWL_TEMPLATES_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CRAWL_PROFILES_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CRAWL_WORKFLOWS_MODE=go
API_GO_CRAWL_WORKFLOW_TRIAL_MODE=go
API_GO_CRAWL_FRONTIER_RUNS_MODE=go
# 与 FRONTIER_RUNS 同侧：创建/重试返回同一个 run-detail payload，go 时要求 RUNS=go。
API_GO_CRAWL_FRONTIER_WRITES_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CRAWL_READ_TELEMETRY_MODE=go
API_GO_SEARCH_REINDEX_MODE=go
API_GO_GDELT_SNAPSHOT_REFRESH_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_NEWS_SOURCES_MODE=go
API_GO_NEWS_SOURCE_OPS_MODE=go
#
# --- 2C 业务对象写入（条目、分析、设置、新闻、经济、态势） ---
# 业务对象写入批次较大，建议按 4–6 个开关一组切，组间停留至少一个业务周期（见 runbook §4.1）。
# CONTENT_SUBSCRIPTIONS / USER_DIGEST / USER_NEWS_BEHAVIOR 相互独立；摘要邮件 Cron 另由阶段 3 的 USER_DIGEST_DELIVERY 控制。
# NEWSNOW_HOTTEST 的自动导入路径需要 items.write；CLASSIFICATION_REPORTS 会入队 classification_quality（消费者在阶段 4）。
API_GO_ITEMS_INGEST_MODE=go
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_RBAC_MODE=go
# [已固定 go] compose 硬编码 go；阶段 0 严格全 legacy 需覆盖
API_GO_USER_SETTINGS_WRITE_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_USER_DIGEST_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_USER_NEWS_BEHAVIOR_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CONTENT_SUBSCRIPTIONS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_ANALYSIS_VIEWS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_ANALYSIS_BOARDS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_ANALYSIS_THREADS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_NEWS_INDICATORS_MODE=go
API_GO_NEWSNOW_HOTTEST_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_NEWSNOW_CLUSTERING_OPS_MODE=go
API_GO_ECONOMIC_DATA_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_CLASSIFICATION_RSS_OPS_MODE=go
API_GO_CLASSIFICATION_REPORTS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_SITUATION_MONITORS_MODE=go
API_GO_PIPELINE_RECOVERY_WRITE_MODE=go
API_GO_NEWS_CLUSTERING_LLM_BACKFILL_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_AVATAR_UPLOAD_MODE=go
#
# --- 2D 身份 / 登录 / 会话写入（高风险，放本阶段最后） ---
# 登录 / MFA / OIDC / 注册入组是高危写路径，必须放在本阶段最后，并先完成 runbook §5 的 SMTP、OIDC 真实验证。
# AUTH_LOGIN 与 IDENTITY_ONBOARDING 会同步真实发信，要求 SMTP_* 完整。
# SITUATION_TELEGRAM_AUTH 要求 SYSTEM_SETTINGS_ENCRYPTION_KEY；不要求 Telegram 会话在 Go（会话 worker 在阶段 4）。
API_GO_IDENTITY_ONBOARDING_MODE=go
API_GO_AUTH_FACTORS_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_ACCOUNT_SECURITY_MODE=go
API_GO_OIDC_LOGIN_MODE=go
API_GO_SITUATION_TELEGRAM_AUTH_MODE=go
API_GO_AUTH_LOGIN_MODE=go
#
# --- 2E GraphQL Mutation（依赖 2C/2D 的数据语义） ---
# GraphQL 写开关彼此独立；本组只注册 Mutation，不改读 root 归属。
# ANALYSIS_RUNS_MODE 同时是三个 analysis run Mutation 的开关（队列消费者是阶段 4 的 ANALYSIS_WORKER_MODE）。
# GRAPHQL_ALERT_RULES_MODE 会写 BullMQ alerts 队列；消费者在阶段 4。
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_ORG_ACCESS_WRITE_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_WORKSPACE_WRITE_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_SETTINGS_WRITE_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_SOURCE_POLICY_WRITE_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_ALERT_RULES_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_RSS_TRANSLATION_MODE=go
# [需 override] compose 的 api-go 服务硬编码 legacy，需 cutover override 重新声明本变量才生效
API_GO_GRAPHQL_KNOWLEDGE_REVIEW_MODE=go
API_GO_GRAPHQL_ASSISTANT_WRITE_MODE=go
API_GO_GRAPHQL_NEWS_INDICATOR_REFRESH_MODE=go
API_GO_ANALYSIS_RUNS_MODE=go

# ============================================================================
# 阶段 3 · Cron / Interval / 启动任务 / 后台调度
# ============================================================================
#
# --- 3A 启动对齐与保留清理 ---
# 启动对齐 / 保留清理是低风险后台任务，但 STARTUP_RECONCILE 会改 Mongo TTL 索引与 Elasticsearch ensureIndex，建议先在预发验证。
# BULLMQ_CLEANUP 与 CRAWL_MAINTENANCE 会删/改队列与任务状态，切换前先确认没有人工排障中的任务。
API_GO_STARTUP_RECONCILE_MODE=go
API_GO_BULLMQ_CLEANUP_MODE=go
API_GO_AUDIT_LOG_RETENTION_MODE=go
API_GO_CRAWL_MAINTENANCE_MODE=go
#
# --- 3B Outbox 补偿链（审计 / raw_item / processed_item） ---
# 三个 Outbox 都是补偿链；切换前后要观察对应失败计数是否下降而不是上升。
# PROCESSED_ITEM_OUTBOX 与 RAW_ITEM_OUTBOX 依赖 SCHEDULE_ENABLED=true 才会定时扫描。
API_GO_AUDIT_OUTBOX_MODE=go
API_GO_RAW_ITEM_OUTBOX_MODE=go
API_GO_PROCESSED_ITEM_OUTBOX_MODE=go
#
# --- 3C 入库 / 时间线 / 情绪 / 指标关联（固定周期 Cron） ---
# 固定周期任务与 NestJS 共用 tick gate / 组织锁；切换应先 api 后 api-go，回退相反。
# NEWS_EVENTS_INGESTION 额外读取 NEWS_EVENTS_INGESTION_SETTLE_MS（默认 120000）。
API_GO_KNOWLEDGE_GRAPH_INGESTION_MODE=go
API_GO_NEWS_EVENTS_INGESTION_MODE=go
API_GO_NEWS_EVENTS_TIMELINE_MODE=go
API_GO_SENTIMENT_SNAPSHOT_MODE=go
API_GO_NEWS_INDICATOR_ASSOCIATION_CRON_MODE=go
#
# --- 3D 业务调度器（新闻源、实时信号、NewsNow、GDELT、摘要、告警评估） ---
# 调度器接管后 NestJS 在领取时间片/加锁前退出，两侧不会同时刷新同一组织。
# USER_DIGEST_DELIVERY 每分钟 tick；每日摘要按用户时区。
# CLASSIFICATION_REVIEW_SEED 在唯一的 itemPipeline 事件流上入队，依赖阶段 4 的 ITEM_PIPELINE_WORKER 已接管。
API_GO_NEWS_SOURCE_SCHEDULER_MODE=go
API_GO_REALTIME_SIGNALS_MODE=go
API_GO_NEWSNOW_BACKGROUND_MODE=go
API_GO_GDELT_SNAPSHOT_MODE=go
API_GO_USER_DIGEST_DELIVERY_MODE=go
API_GO_CLASSIFICATION_QUALITY_ALERT_MODE=go

# ============================================================================
# 阶段 4 · BullMQ 队列 worker
# ============================================================================
#
# --- 4A 条目流水线（BRIEF 指定的第一步） ---
# BRIEF 指定先切条目流水线。itemPipeline 的 producer 仍在 NestJS/Go 两侧，消费者只能有一个 owner。
# 切换前确认 bull:itemPipeline:active 为 0 或已排空；回退时先停 Go worker 再恢复 Nest 消费。
API_GO_ITEM_PIPELINE_WORKER_MODE=go
#
# --- 4B 爬取 worker 与 Frontier LLM worker ---
# 爬取 worker 三条队列（crawl4ai / crawl4ai-hot / crawl4ai-normal）由同一开关接管，并共用全局并发限制器。
# Frontier LLM 两个队列（frontier-llm-judge / frontier-llm-learn）单独开关；go 要求 SYSTEM_SETTINGS_ENCRYPTION_KEY。
API_GO_CRAWL_WORKER_MODE=go
API_GO_CRAWL_FRONTIER_LLM_WORKER_MODE=go
#
# --- 4C 其余业务 worker ---
# 其余 worker 按“低风险 → 高风险”排序：归档准备、经济数据、分类质量、聚类恢复、分析、助手、告警。
# ALERT_WORKER 会真实发信/发 Webhook，切换前完成 runbook §5 的 SMTP 与 Webhook 验证。
# NEWS_CLUSTERING_RECOVERY_WORKER 同时涉及每 5 分钟 cron 与队列消费。
API_GO_ANALYSIS_WORKER_MODE=go
API_GO_ASSISTANT_WORKER_MODE=go
API_GO_ALERT_WORKER_MODE=go
API_GO_ECONOMIC_DATA_WORKER_MODE=go
API_GO_ARCHIVE_PREPARATION_WORKER_MODE=go
API_GO_CLASSIFICATION_QUALITY_WORKER_MODE=go
API_GO_NEWS_CLUSTERING_RECOVERY_WORKER_MODE=go
API_GO_CLASSIFICATION_REVIEW_SEED_MODE=go
#
# --- 4D 态势信号 worker（手动刷新在阶段 2 分组，但必须等本组与 3D 完成后才执行） ---
# SITUATION_SIGNALS_WORKER 接管 situationMonitorSignals（telegram-poll + oref-poll），要求 Telegram 会话只由 Go 租约持有。
# SITUATION_REFRESH 强依赖 SIGNALS_WORKER=go 且 NEWS_SOURCE_SCHEDULER=go（config.go:6177/6180），所以手动刷新必须排在调度器（3D）与信号 worker 之后。
API_GO_SITUATION_SIGNALS_WORKER_MODE=go

# ============================================================================
# 阶段 5 · 实时推送（GraphQL Subscription / 两个 Socket.IO 路径 / Web 重建）
# ============================================================================
#
# --- 5A GraphQL Subscription（要求 GRAPHQL_SUBSCRIPTION_BUS=redis） ---
# GraphQL Subscription 需要 GRAPHQL_SUBSCRIPTION_BUS=redis；Nest 与 Go 必须看到同一值。
# 只接管 graphql-transport-ws upgrade；HTTP GET/POST/OPTIONS 仍按读/写开关处理，其他 upgrade 与更长路径继续代理 NestJS。
API_GO_GRAPHQL_SUBSCRIPTIONS_MODE=go
#
# --- 5B 两个独立 Socket.IO 路径（要求 WS_REDIS_ADAPTER_ENABLED=true） ---
# 两个 Socket.IO 路径是独立传输：/socket.io-notifications 只服务 /notifications，/socket.io-realtime 服务 /newsnow /ops /quality /queue /situation-monitor。
# REALTIME_SOCKET_MODE=go 要求 WS_REDIS_ADAPTER_ENABLED=true（config.go:6008）。
# 这两个路径由浏览器直连，必须同步重建 Web 镜像（NEXT_PUBLIC_* 是构建期参数），否则浏览器仍连 /socket.io。
API_GO_NOTIFICATIONS_SOCKET_MODE=go
API_GO_REALTIME_SOCKET_MODE=go

# ============================================================================
# 阶段 6 · 认证健康检查与停 Nest 判定（停 Nest 当前存在硬阻断，见 runbook）
# ============================================================================
#
# --- 6A 认证版 /api/healthz（注意：公开 /api/healthz/live 永远是 shadow） ---
# API_GO_HEALTHZ_MODE=go 只接管认证版 GET /api/healthz；公开 GET /api/healthz/live 永远是 shadow（legacyproxy/proxy.go:136），Nest 仍必须应答。
# 因此本阶段不能作为“停 Nest”的开关；停 Nest 的硬阻断见 runbook §3.6 与 §4。
# [需 override] compose 未注入本变量，由 cutover override 的 env_file 注入
API_GO_HEALTHZ_MODE=go

# ============================================================================
# 文件结束
# 复核方法（不启动服务）：
#   grep -cE '^API_GO_[A-Z0-9_]+_MODE=go$' infra/docker/api-go-cutover.env.sample   # 应为 131
#   diff <(grep -oE '^API_GO_[A-Z0-9_]+_MODE' infra/docker/api-go-cutover.env.sample | sort) \
#        <(grep -o 'getenv("API_GO_[A-Z0-9_]*")' apps/api-go/internal/config/config.go \
#          | sed 's/getenv("//;s/")//' | sort)                                      # 应无差异
# ============================================================================
