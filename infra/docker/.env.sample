# Docker Compose still uses MYSQL_* to provision the MySQL container.
# DATABASE_URL is not required here unless you explicitly need a host-side override.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DB=app
MONGO_HOST_PORT=27017
MONGO_URI=mongodb://root:secret@mongo:27017/app?authSource=admin
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_AUTO_INDEX=false
MONGO_BUFFER_COMMANDS=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_ENABLE_AUTO_PIPELINING=true
REDIS_MAX_RETRIES_PER_REQUEST=3
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT_SECONDS=10
PRISMA_TRANSACTION_MAX_WAIT_MS=5000
PRISMA_TRANSACTION_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_ENABLED=true
HTTP_AGENT_MAX_SOCKETS=64
HTTP_AGENT_MAX_FREE_SOCKETS=16
HTTP_AGENT_TIMEOUT_MS=60000
# Validate AOF files at Redis startup and auto-repair corruption when possible.
REDIS_AOF_CHECK_ON_START=true
# Keep this false in production-like setups; use `pnpm docker:redis:repair` for explicit offline repair.
REDIS_AOF_AUTO_FIX=false
# docker-up preflight runs an offline repair (with backup) before bringing the stack up.
REDIS_AOF_PREFLIGHT_AUTO_REPAIR=true
# Number of redis-check-aof log lines shown when preflight/repair detects corruption.
REDIS_AOF_PREFLIGHT_LOG_TAIL=40
# Keep only the newest N auto-repair backups under /data/aof-backups.
REDIS_AOF_BACKUP_KEEP=5
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=litellm
LITELLM_DATABASE_URL=postgresql://litellm:litellm@litellm-postgres:5432/litellm
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wei500l@163.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Wei <wei500l@163.com>"
# REQUIRED: generate with `openssl rand -hex 32`. Startup/env:check fail fast
# until a real (non-placeholder) value is set.
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
API_BASE_URL=http://api:4000
API_HOST_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_GRAPHQL_APQ_ENABLED=true
NEXT_PUBLIC_LLM_GATEWAY_DEFAULT_API_BASE=http://litellm:4000
AKSHARE_HTTP_BASE_URL=http://akshare:8081
# Akshare gateway toggle (set to false to disable all Akshare jobs).
AKSHARE_ENABLED=true
AKSHARE_PORT=8081
# NOTE: akshare>=1.16.72 requires Python >= 3.9 (aiohttp>=3.11.13). Use a 3.11+ base image.
# If Docker Hub is slow/blocked, prefer a mirror such as `docker.m.daocloud.io`.
AKSHARE_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
# Akshare gateway: pin a version for reproducible builds, or set to "latest" for rolling upgrades.
AKSHARE_VERSION=1.18.39
# Akshare gateway admin token (required for the UI "upgrade akshare" action)
AKSHARE_ADMIN_TOKEN=change_me_please
NODE_ENV=production
# Docker JSON log rotation. Keeps per-container log files bounded.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
# Docker build base image for api/web runtime images (use a mirror if Docker Hub is unstable/blocked).
NODE_IMAGE=docker.m.daocloud.io/library/node:20
# Optional: override registry / DNS when containers cannot resolve registry.npmjs.org
# NPM_REGISTRY=https://registry.npmmirror.com
# DOCKER_DNS_1=223.5.5.5
# DOCKER_DNS_2=114.114.114.114
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_DEPTH_LIMIT=8
GRAPHQL_COMPLEXITY_LIMIT=2000
GRAPHQL_APQ_ENABLED=true
GRAPHQL_RESPONSE_CACHE_ENABLED=true
GRAPHQL_RESPONSE_CACHE_MAX_AGE_SECONDS=30
# CORS origin allowlist (comma-separated). REQUIRED in production: without
# it the API refuses to start. Must match the browser-facing web origin(s).
CORS_ORIGIN=http://localhost:3000
# WebSocket security (Socket.IO)
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_PER_IP=50
WS_CONNECT_RATE_LIMIT_PER_IP=60
WS_CONNECT_RATE_LIMIT_PER_USER=30
WS_CONNECT_RATE_LIMIT_WINDOW_SECONDS=60
# Observability client exception ingest limits (per configurable window)
# - User scope key: observability:client-exception:user:{orgId}:{userId}
# - IP scope key: observability:client-exception:ip:{orgId}:{ip}
# - Window controls both user/ip buckets; keep it aligned with dashboard alert windows.
OBSERVABILITY_CLIENT_EXCEPTION_USER_RATE_LIMIT=30
OBSERVABILITY_CLIENT_EXCEPTION_IP_RATE_LIMIT=120
OBSERVABILITY_CLIENT_EXCEPTION_RATE_LIMIT_WINDOW_SECONDS=60
# Prometheus metrics are exposed at /api/metrics and require a token with metrics.read.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=modular-api
OTEL_EXPORTER_OTLP_ENDPOINT=
AUTH_PROFILE_CACHE_TTL_SECONDS=600
AUTH_PROFILE_CACHE_LOCK_TTL_MS=5000
AUTH_PROFILE_CACHE_MAX_WAIT_MS=5000
AUTH_PROFILE_CACHE_RETRY_DELAY_MS=50
AUTH_REFRESH_GRACE_SECONDS=10
AUDIT_LOG_RETENTION_DAYS=90
TASK_LOG_RETENTION_DAYS=14
# Docker Compose (extras profile): override crawl4ai image (use `:0` to track latest releases without pinning to a minor/patch).
CRAWL4AI_IMAGE=unclecode/crawl4ai:0
# Crawl4AI: enable Xvfb for headed browser runs (headless=false).
CRAWL4AI_XVFB_ENABLED=true
CRAWL4AI_XVFB_DISPLAY_NUM=99
CRAWL4AI_XVFB_SCREEN=1920x1080x24
# Optional: force Crawl4AI container traffic through host proxy (Clash/V2Ray etc.).
# If crawl4ai runs in Docker, prefer host.docker.internal instead of localhost/127.0.0.1.
CRAWL4AI_HTTP_PROXY=http://host.docker.internal:7890
CRAWL4AI_HTTPS_PROXY=http://host.docker.internal:7890
CRAWL4AI_NO_PROXY=localhost,127.0.0.1,crawl4ai,api,web,db,redis,host.docker.internal
CRAWL4AI_BASE_URL=http://crawl4ai:11235
# Web console: embed Crawl4AI built-in UI (browser-accessible URL, e.g. `/dashboard/` or `/playground/`).
CRAWL4AI_DASHBOARD_URL=http://localhost:8082/dashboard/
# Keep worker-side SSRF protection enabled. The crawl4ai browser uses this local proxy
# to pin DNS resolution and block localhost/private/metadata targets at fetch time.
CRAWL4AI_SSRF_PROXY_URL=http://127.0.0.1:18080
# Internal-only listener inside the crawl4ai container. Do not expose it on the host.
CRAWL4AI_SSRF_PROXY_PORT=18080
CRAWL4AI_API_KEY=
CRAWL4AI_TIMEOUT_MS=120000
CRAWL4AI_MAX_CONCURRENCY=3
CRAWL4AI_MAX_RETRIES=3
CRAWL4AI_HEALTH_CHECK_TTL_MS=60000
CRAWL4AI_RETRY_BACKOFF_MS=5000
CRAWL_MEDIA_FETCH_TIMEOUT_MS=15000
CRAWL_MEDIA_MAX_BYTES=2097152
CRAWL_MEDIA_MAX_PER_RESULT=6
# Bootstrap defaults only; runtime completion/embedding/rerank model routing is read from
# Settings -> LLM gateway profiles stored in MySQL.
LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_API_BASE=http://litellm:4000
LITELLM_API_KEY=
LITELLM_TIMEOUT_MS=60000
LITELLM_TEMPERATURE=0.2
LITELLM_TOP_P=0.9
LITELLM_MAX_OUTPUT_TOKENS=1200
LITELLM_MAX_RETRIES=3
LITELLM_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-3-haiku
ITEMS_SEARCH_RERANK_ENABLED=true
ITEMS_SEARCH_RECALL_MAX_CANDIDATES=120
ITEMS_SEARCH_RERANK_MAX_CANDIDATES=40
ITEMS_SEARCH_RERANK_TIMEOUT_MS=300
ITEMS_SEARCH_RECENCY_HALFLIFE_HOURS=48
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_ITEMS_INDEX=items-v1
ELASTICSEARCH_ITEMS_ALIAS=items-current
ELASTICSEARCH_REQUEST_TIMEOUT_MS=2000
# Optional: allow LiteLLM Proxy container to fetch OpenAI keys from API (stored in MySQL)
# - Web app does NOT need this token (organization switch error reporting uses user JWT).
LITELLM_CONFIG_INTERNAL_TOKEN=
# Optional: override API base used for the fetch (docker default is http://api:4000/api)
LITELLM_CONFIG_API_BASE=http://api:4000/api
# Assistant content safety (LiteLLM Proxy guardrails)
ASSISTANT_GUARDRAILS_ENABLED=true
ASSISTANT_GUARDRAILS=openai-moderation-pre
# Optional: protect LiteLLM proxy and enable API-side governance sync.
# Reuse the same master key in both API and LiteLLM when managed governance is enabled.
# LITELLM_MASTER_KEY=dev-litellm-master-key
# Upstream provider credentials for LiteLLM proxy
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional legacy fallback: multi-deployment load balancing via env (comma-separated).
# Preferred path is DB-managed config via System Settings -> LLM Gateway -> Load balancing.
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
# Optional legacy fallback router settings for env-based load balancing.
LITELLM_ROUTING_STRATEGY=simple-shuffle
LITELLM_REDIS_HOST=redis
LITELLM_REDIS_PORT=6379
LITELLM_REDIS_PASSWORD=
# Optional: per-deployment weights for load balancing.
LITELLM_DEPLOYMENT_RPM=
LITELLM_DEPLOYMENT_TPM=
# Vector service (docker compose extras profile)
VECTOR_SERVICE_ENABLED=false
VECTOR_SERVICE_FALLBACK_TO_MONGO=true
VECTOR_SERVICE_BASE_URL=http://vector:4010
VECTOR_INTERNAL_TOKEN=dev-token
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
VECTOR_COLLECTION_PREFIX=processed_item_summary
# Model service (time-series forecasting / anomaly detection)
MODEL_SERVICE_ENABLED=true
MODEL_SERVICE_BASE_URL=http://model-service:8090
MODEL_SERVICE_INTERNAL_TOKEN=dev-model-token
MODEL_SERVICE_PORT=8090
MODEL_SERVICE_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
MODEL_SERVICE_TIMEOUT_MS=15000
MODEL_SERVICE_MAX_RETRIES=2
SITUATION_MONITOR_TRANSLATION_API_ENABLED=true
SITUATION_MONITOR_TRANSLATION_API_BASE_URL=https://api.deeplx.org
SITUATION_MONITOR_TRANSLATION_TIMEOUT_MS=15000
SITUATION_MONITOR_TRANSLATION_MAX_RETRIES=2
SITUATION_MONITOR_TRANSLATION_FALLBACK_API_ENABLED=false
SITUATION_MONITOR_TRANSLATION_FALLBACK_API_BASE_URL=
REALTIME_SIGNALS_ACLED_USERNAME=
REALTIME_SIGNALS_ACLED_PASSWORD=
REALTIME_SIGNALS_ACLED_CLIENT_ID=acled
# Realtime signals / AIS relay (Docker dev)
# API requests: ${REALTIME_SIGNALS_AIS_BASE_URL}/ais/snapshot
# REALTIME_SIGNALS_AIS_SHARED_SECRET must match AIS_RELAY_SHARED_SECRET.
# `/healthz/live` is the container liveness probe. `/health` remains the
# runtime diagnostics endpoint and may report `status=degraded` while the
# relay process is still healthy enough for API startup.
AIS_RELAY_PORT=3004
REALTIME_SIGNALS_AIS_BASE_URL=http://ais-relay:3004
REALTIME_SIGNALS_AIS_SHARED_SECRET=change_me_generate_a_long_random_secret
AIS_RELAY_SHARED_SECRET=change_me_generate_a_long_random_secret
# Optional custom upstream for smoke tests or internal proxying.
# Defaults to the public AISStream websocket endpoint when unset.
# Prefer this key over the legacy alias `AIS_RELAY_UPSTREAM_URL`.
AISSTREAM_URL=
# REQUIRED: the ais-relay refuses to start without this key
AISSTREAM_API_KEY=change-me-aisstream-api-key
# Relay health will degrade if no upstream message arrives within this window
# after a websocket connection is established.
AIS_RELAY_HEALTH_NO_MESSAGES_AFTER_CONNECT_MS=60000
# Relay health will degrade if the websocket stays open but message flow stalls
# for longer than this window.
AIS_RELAY_HEALTH_STALE_MESSAGES_MS=90000
# Advanced thresholds for normalization / parse-failure based degradation.
AIS_RELAY_HEALTH_MIN_POSITION_REPORTS=25
AIS_RELAY_HEALTH_MAX_IGNORED_RATIO_PERCENT=85
AIS_RELAY_HEALTH_MAX_PARSE_ERROR_RATIO_PERCENT=20
REALTIME_SIGNALS_CLOUDFLARE_API_TOKEN=
REALTIME_SIGNALS_WINGBITS_API_KEY=
REALTIME_SIGNALS_POLYMARKET_PROXY_URL=
# Situation Monitor live HLS proxy is configured in MySQL (System Settings -> Situation Monitor)
SITUATION_MONITOR_TELEGRAM_ENABLED=false
SITUATION_MONITOR_TELEGRAM_API_ID=
SITUATION_MONITOR_TELEGRAM_API_HASH=
SITUATION_MONITOR_TELEGRAM_CHANNEL_SET=full
SITUATION_MONITOR_TELEGRAM_MAX_FEED_ITEMS=200
SITUATION_MONITOR_TELEGRAM_MAX_TEXT_CHARS=800
SITUATION_MONITOR_TELEGRAM_CHANNEL_TIMEOUT_MS=15000
SITUATION_MONITOR_TELEGRAM_POLL_CYCLE_TIMEOUT_MS=180000
SITUATION_MONITOR_TELEGRAM_STARTUP_DELAY_MS=60000
SITUATION_MONITOR_TELEGRAM_RATE_LIMIT_MS=800
SITUATION_MONITOR_TELEGRAM_POLL_INTERVAL_MS=60000
SITUATION_MONITOR_OREF_ENABLED=false
SITUATION_MONITOR_OREF_PROXY_AUTH=
SITUATION_MONITOR_OREF_ALERTS_URL=https://www.oref.org.il/WarningMessages/alert/alerts.json
SITUATION_MONITOR_OREF_HISTORY_URL=https://www.oref.org.il/WarningMessages/alert/History/AlertsHistory.json
SITUATION_MONITOR_OREF_HISTORY_RETENTION_DAYS=7
SITUATION_MONITOR_OREF_HISTORY_MAX_WAVES=200
SITUATION_MONITOR_OREF_CURL_TIMEOUT_SEC=15
SITUATION_MONITOR_OREF_BOOTSTRAP_MAX_RETRIES=3
SITUATION_MONITOR_OREF_POLL_INTERVAL_MS=300000
NEWS_PIPELINE_CACHE_TTL_SECONDS=3600
NEWS_PIPELINE_MAX_INPUT_CHARS=48000
NEWS_PIPELINE_CONFIG_PATH=config/news-pipeline.config.docker.yaml
SYSTEM_SETTINGS_ENCRYPTION_KEY=
# MinIO (local S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 storage (defaults to MinIO in docker-compose)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=modular-avatars
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/modular-avatars
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=300

# Optional: Python package index for akshare gateway
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
