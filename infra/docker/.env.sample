# Docker Compose still uses MYSQL_* to provision the MySQL container.
# DATABASE_URL is not required here unless you explicitly need a host-side override.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_USER=root
# REQUIRED: generate with `openssl rand -hex 24`. Do not use `secret`.
MYSQL_PASSWORD=
MYSQL_DB=app
MONGO_HOST_PORT=27017
MONGO_ROOT_USERNAME=root
# REQUIRED: generate with `openssl rand -hex 24`. Docker Mongo refuses empty/default secrets.
MONGO_ROOT_PASSWORD=
# Keep in sync with MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD after you generate them.
MONGO_URI=
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_AUTO_INDEX=false
MONGO_BUFFER_COMMANDS=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
# REQUIRED: generate with `openssl rand -hex 24`. Redis refuses to start without AUTH.
REDIS_PASSWORD=
REDIS_ENABLE_AUTO_PIPELINING=true
REDIS_MAX_RETRIES_PER_REQUEST=3
# Redis 限流降级策略：false=Redis 故障时拒绝请求（fail-closed，防登录/抓取/RBAC 限流被绕过）；true=故障时放行（不推荐）
RATE_LIMIT_REDIS_FAIL_OPEN=false
# 运行时与治理设置（API_GO_RUNTIME_SETTINGS_MODE）读取的限流桶默认值：
# SystemSetting 无对应行时返回这些值，与 NestJS EnvService getter 同名同
# 默认。crawlCreate / rbacWrite 两个桶与登录桶都受 RATE_LIMIT_REDIS_FAIL_OPEN
# 的 fail-closed 语义约束。
RATE_LIMIT_CRAWL_TASK_CREATE=10
RATE_LIMIT_CRAWL_TASK_CREATE_WINDOW=300
RATE_LIMIT_RBAC_WRITE=20
RATE_LIMIT_RBAC_WRITE_WINDOW=600
# GET/PUT /api/system-settings/rate-limits 的 Redis 缓存 TTL（秒）；缺省或
# 非正数回落到 60。
RATE_LIMIT_SETTINGS_CACHE_TTL_SECONDS=60
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT_SECONDS=10
PRISMA_TRANSACTION_MAX_WAIT_MS=5000
PRISMA_TRANSACTION_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_ENABLED=true
HTTP_AGENT_MAX_SOCKETS=64
HTTP_AGENT_MAX_FREE_SOCKETS=16
HTTP_AGENT_TIMEOUT_MS=60000
# Validate AOF files at Redis startup and auto-repair corruption when possible.
REDIS_AOF_CHECK_ON_START=true
# Keep this false in production-like setups; use `pnpm docker:redis:repair` for explicit offline repair.
REDIS_AOF_AUTO_FIX=false
# docker-up preflight runs an offline repair (with backup) before bringing the stack up.
REDIS_AOF_PREFLIGHT_AUTO_REPAIR=true
# Number of redis-check-aof log lines shown when preflight/repair detects corruption.
REDIS_AOF_PREFLIGHT_LOG_TAIL=40
# Keep only the newest N auto-repair backups under /data/aof-backups.
REDIS_AOF_BACKUP_KEEP=5
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
# REQUIRED: generate with `openssl rand -hex 24`. Do not use `litellm`.
LITELLM_POSTGRES_PASSWORD=
LITELLM_DATABASE_URL=
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wei500l@163.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Wei <wei500l@163.com>"
# REQUIRED: generate with `openssl rand -hex 32`. Startup/env:check fail fast
# until a real (non-placeholder) value is set.
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# 服务端运行期 API base（web 容器运行时读取，切换无需重建镜像）。
# legacy（默认）：http://api:4000
# api-go-pilot：http://api-go:4020（需 `docker compose --profile api-go-pilot up -d api-go`）
# 回滚 legacy：指回 http://api:4000 并 `docker compose up -d web` 即可（无数据耦合）。
API_BASE_URL=http://api:4000
API_HOST_PORT=4000
# 浏览器端 API base（构建期内联进 web 镜像——切换浏览器流量需以该值
# 重建 web 镜像）。api-go-pilot 模式指向 api-go 对外地址：
# http://localhost:4020/api（API_GO_HOST_PORT 同步修改）。
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# api-go pilot（Go-批2C）：独立 profile，默认不启动。启用：
#   docker compose --profile api-go-pilot up -d api-go
# host 侧发布端口（默认只绑 loopback，同 DOCKER_PUBLISH_HOST）。
API_GO_HOST_PORT=4020
# api-go 构建阶段的基础镜像（与 VECTOR_GO_IMAGE 同一约定）。
API_GO_IMAGE=golang:1.27
# onboarding GET 迁移单元的路由模式（Go-批3A）。compose 的 api-go
# pilot 服务固定注入 go（首个 Go 全响应业务端点：Go 独立 JWT 验签 +
# Redis blacklist + MySQL RBAC）；此变量用于本地/手工启动 api-go 时
# 显式降级。默认 shadow=旧行为（NestJS 响应 + Go 差分）；非法值启动
# 失败；go 模式要求 JWT_SECRET/DATABASE_URL/REDIS_HOST 齐备。回滚=
# 改回 shadow（无数据迁移耦合）。
API_GO_ONBOARDING_MODE=shadow
# user-settings 六个只读 GET 的统一读模式（Go-批3B）。compose 的 api-go
# pilot 服务固定注入 go（六个 GET 全部由统一 Go handler 接管：onboarding/
# rss-reader/spacetime-timeline/war-map/newsnow/situation-monitor）。
# 优先级：设置时覆盖 API_GO_ONBOARDING_MODE 对 onboarding 的控制。
# 未设置（空）=兼容旧行为（onboarding 由上面的变量控制，rss/spacetime
# shadow，war-map/newsnow/situation-monitor legacy）。回滚=改回 shadow
# 或删除本变量（无数据迁移耦合）。
API_GO_USER_SETTINGS_READ_MODE=
# 六个 user-settings PUT（Go-批3C）。legacy=代理 NestJS；go 要求读模式
# 同为 go。compose pilot 服务固定注入 go，此样例保持 legacy。
API_GO_USER_SETTINGS_WRITE_MODE=legacy
# 公开首页、频道和故事详情（Go-批4A/4B）。legacy=代理 NestJS（默认）；
# go=Go 独立查 MySQL 并响应 home、channels/:topic、stories/id/:id、
# stories/slug/:slug（后三个恰好一个路径段，仅 GET）。go 只要求
# DATABASE_URL。详情冷路径复用 llm_gateway_profiles 与
# SYSTEM_SETTINGS_ENCRYPTION_KEY。启用 go 前应确认模型网关配置可用；
# 缓存缺失时的真实模型调用尚未在远端验证。默认生产入口不切换。
# compose pilot 固定注入 go。回滚=改回 legacy。
API_GO_PUBLIC_PORTAL_MODE=legacy
# GET /api/dashboard/stats（Go-批5A）。legacy=代理 NestJS（默认）；
# go=Go 独立验签并读 MySQL/Mongo/Redis。只这一条精确 GET。
# go 要求 JWT_SECRET、DATABASE_URL、REDIS_HOST、MONGO_URI。
# compose pilot 固定注入 go。回滚=改回 legacy。不新增表。
API_GO_DASHBOARD_STATS_MODE=legacy
# War Map events 与 news-markers（Go-批5C）。legacy=代理 NestJS（默认）；
# go=Go 独立验签并读 MySQL，新闻记录为空时才回退 Mongo。
# 只这两条精确 GET。go 要求 JWT_SECRET、DATABASE_URL、REDIS_HOST、MONGO_URI。
# 地理查询与 zh-CN 翻译沿用 GEO_* / SITUATION_MONITOR_TRANSLATION_* 和 SystemSetting。
# compose pilot 固定注入 go。回滚=改回 legacy。不新增表。
API_GO_DASHBOARD_WAR_MAP_MODE=legacy
# 个人内容三域（Go-批7）。各自默认 legacy，只控制对应 HTTP 路由。
# go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST。订阅和摘要还要求 MONGO_URI。
# 行为画像不要求 Mongo。ES、模型凭据和 SMTP 不是启动条件。
# 三个开关互不影响。pilot 默认不把这 15 条从 NestJS 切走。
API_GO_CONTENT_SUBSCRIPTIONS_MODE=legacy
API_GO_USER_NEWS_BEHAVIOR_MODE=legacy
API_GO_USER_DIGEST_MODE=legacy
# 每日摘要后台投递所有权，与上面三个 HTTP 开关独立。默认 legacy=保留 NestJS
# Cron；go=Go 每分钟扫描、按组织认领到期日程、生成摘要、真实 SMTP 投递并写回
# 状态，同时发摘要专用通知。空串按 legacy 处理；非法值在 Nest 与 Go 都启动失败。
# go 要求 DATABASE_URL、REDIS_HOST、MONGO_URI 和 SMTP_*，不要求 JWT_SECRET。
# delivery-only 时上述三个 HTTP 开关以及 CONTENT_SUBSCRIPTIONS、
# USER_NEWS_BEHAVIOR、RUNTIME_SETTINGS、AUTH_LOGIN、IDENTITY_ONBOARDING 和全部
# GraphQL 模式均可保持 legacy。切换与回滚顺序见 apps/api-go/README.md。
API_GO_USER_DIGEST_DELIVERY_MODE=legacy
# 分析工作台三个 HTTP 域。各自默认 legacy，只控制对应精确路由。
# go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST，不要求 Mongo。
# 讨论检查、评论计数和删除清理不看另一个 HTTP 开关。
# exports、GraphQL、worker 不随这三个开关变化。compose pilot 也保持 legacy。
API_GO_ANALYSIS_VIEWS_MODE=legacy
API_GO_ANALYSIS_BOARDS_MODE=legacy
API_GO_ANALYSIS_THREADS_MODE=legacy
# 条目/事件 CSV 导出两条精确 POST：/api/analysis/exports/items 与 /events。
# 默认 legacy，只接受空串/legacy/go。go 时要求 JWT_SECRET、DATABASE_URL、
# REDIS_HOST、MONGO_URI；单次最多 5000 行，保留筛选/排序/个性化、事件热度与
# 来源可信度、字段补全和 CSV 契约。三条导出里的 POST /exports/search 因
# headlines 归档准备继续留在 NestJS，本开关不注册它。compose pilot 也保持 legacy。
API_GO_ANALYSIS_EXPORT_MODE=legacy
# 态势监控自定义监控（GET/POST /monitors、POST /monitors/preview、
# PATCH/DELETE /monitors/:id）。默认 legacy，只接受 legacy 或 go。
# go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST。模型与 Nominatim 不是启动条件。
# 不接管 insights、catalog、feedback、refresh、telegram、oref、HLS。
# 已迁的 /api/user-settings/ui/situation-monitor 不看这个开关。
# compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_SITUATION_MONITORS_MODE=legacy
# 态势监控信号读取与反馈（GET catalog、POST feedback、GET refresh-runs/:refreshId、
# GET telegram-feed、GET oref-alerts、GET oref-history、GET live-hls-proxy-config）。
# 默认 legacy，只接受空串/legacy/go，非法值启动失败。go 时要求 JWT_SECRET、
# DATABASE_URL、REDIS_HOST、MONGO_URI（feedback 写
# situationsignalfeedbacks/situationsignallearningstates，refresh-runs 读
# CrawlTask/PipelineJob，信号状态读 Redis 缓存，settings 读 SystemSetting）。
# 不接管 insights、POST refresh、GET/POST /monitors**（看
# API_GO_SITUATION_MONITORS_MODE）与 /api/system-settings/realtime-signals/runtime。
# 不发任何 Telegram/OREF 上游请求，不入队，不启动 worker。
# compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_SITUATION_MONITOR_SIGNALS_MODE=legacy
# 新闻源管理台（列表、options、groups、opml-presets、创建、批量频率、
# OPML preview/import、批量分组/启停/删除、更新、删除、run、schedule）。
# 默认 legacy，只接受 legacy 或 go。非法值启动失败。
# GET /api/admin/news-sources/:id/preview 不在这个开关里。
# compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_NEWS_SOURCES_MODE=legacy
# 采集策略工作流编辑接口（node-schemas、列表、详情、创建、草稿、发布、
# 版本、对比、两条 bridge）。默认 legacy，只接受空串/legacy/go，
# 非法值启动失败，go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST。
# trial-run、replay、workflow-runs、profiles 列表/创建/预览/回滚、
# runs、nodes 不在这个开关里。compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_CRAWL_WORKFLOWS_MODE=legacy
# 采集站点画像编辑接口（列表、匹配、预览、创建、详情、更新、版本、
# 回滚）。默认 legacy，只接受空串/legacy/go，非法值启动失败，
# go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST。
# runs、nodes、workflows 与 workflow-bridge 不在这个开关里，仍回 NestJS。
# compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_CRAWL_PROFILES_MODE=legacy
# 采集模板编辑接口（列表、创建、更新、删除）。默认 legacy，只接受
# 空串/legacy/go，非法值启动失败，go 时要求 JWT_SECRET、DATABASE_URL、
# REDIS_HOST。crawl-tasks、metadata、crawl4ai 队列不在这个开关里，仍回
# NestJS。compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_CRAWL_TEMPLATES_MODE=legacy
# 采集 Frontier 运行监控与取消的 11 条 HTTP（runs 列表/详情、run 的
# workflow-run 与候选、批量/单条取消、nodes/:id、workflow-runs 详情/候选/
# 候选解释）。默认 legacy，只接受空串/legacy/go，非法值启动失败，go 时
# 要求 JWT_SECRET、DATABASE_URL、REDIS_HOST（不要求 MONGO_URI）。
# POST /runs、POST /nodes/retry、POST /nodes/:id/retry、replay 与 trial-run
# 不在这个开关里，仍回 NestJS（会入队或调用 crawl4ai）。
# compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_CRAWL_FRONTIER_RUNS_MODE=legacy
# LLM 请求日志的列表、CSV 导出与用量汇总（/api/llm-logs、/export、
# /summary 三条精确 GET）。默认 legacy，只接受空串/legacy/go，非法值
# 启动失败，go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST、MONGO_URI。
# /api/system-settings/llm-request-logs 会改 Mongo TTL 索引，不在这个
# 开关里，仍回 NestJS。compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_LLM_LOGS_MODE=legacy

# 管理端日志与异常读取 7 条 GET（logs 的 task、task/summary、errors、
# errors/summary、audit，以及 admin/errors 与 admin/errors/stats）。默认
# legacy，只接受空串/legacy/go，非法值启动失败，go 时要求 JWT_SECRET、
# DATABASE_URL、REDIS_HOST、MONGO_URI。admin/quality、observability、
# metrics 与异常上报 POST 不在这个开关里，仍回 NestJS。
# compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_ADMIN_LOGS_MODE=legacy
# 异常上报 2 个 POST（observability/exception-events/client 与
# internal/observability/exception-events）。默认 legacy，只接受空串/
# legacy/go，非法值启动失败，go 时要求 JWT_SECRET、DATABASE_URL、
# REDIS_HOST、MONGO_URI（写入既有 exceptionevents 集合）。只控制这 2 个
# 上报入口，7 条读取 GET 继续用 API_GO_ADMIN_LOGS_MODE。client 入口沿用
# 现有上报限流（OBSERVABILITY_CLIENT_EXCEPTION_*），internal 入口沿用
# LITELLM_CONFIG_INTERNAL_TOKEN（未配置时接口级 403，不影响启动）。
# compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_EXCEPTION_INGEST_MODE=legacy
# 新闻指标关联分析的 3 条 HTTP（associations 列表、associations/:id 详情、
# refresh）与 2 个 GraphQL 只读 query（newsIndicatorAssociations、
# newsIndicatorAssociation）。默认 legacy，只接受空串/legacy/go，非法值
# 启动失败，go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST（不要求 Mongo）。
# GraphQL 两个 query 另需 API_GO_GRAPHQL_READ_MODE=go 才登记；mutation
# refreshNewsIndicatorAssociations 与设置读写仍回 NestJS。compose pilot 保持
# legacy。回滚=改回 legacy。不调用 AkShare，不启动调度。
API_GO_NEWS_INDICATORS_MODE=legacy
# 管理端质量面板 5 条 GET（news-sources、pipeline、overview、task-logs、
# task-logs/summary）。默认 legacy，只接受空串/legacy/go，非法值启动
# 失败，go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST、MONGO_URI。
# 新闻源质量与流水线质量复用 MySQL ObservabilitySnapshot 与 Redis 锁，
# 与 Nest 共享 60 秒快照。classification 与 pipeline-recovery 仍回
# NestJS。compose pilot 保持 legacy。回滚=改回 legacy。
API_GO_QUALITY_OVERVIEW_MODE=legacy
# 分类质量工作台 7 条 + RSS 链路诊断 4 条 + RSS 翻译每日指标 1 条（共 13 条
# 精确路由规则）。默认 legacy，只接受空串/legacy/go，非法值启动失败，go 时
# 要求 JWT_SECRET、DATABASE_URL、REDIS_HOST、MONGO_URI。classificationsamples
# 等 5 个 classification* 集合与 processeditems/tasklogs 在 Mongo，RSS 诊断
# 读 MySQL + ObservabilitySnapshot(scope=rss_diagnostics)。权限统一
# settings.manage。POST /api/admin/quality/classification/reports 会投递
# BullMQ 任务，不迁移，继续回落 NestJS。compose pilot 保持 legacy。
# 回滚=只把本变量改回 legacy。
API_GO_CLASSIFICATION_RSS_OPS_MODE=legacy
# NewsNow 本地计算与聚类失败管理的 9 条 HTTP：metadata、resolve、
# sources/order、domestic-opinion-index，以及 clustering 的 readiness/
# overview/failures 与 failures/:groupId 的 vector-backfill/ignore。默认
# legacy，只接受空串/legacy/go，非法值启动失败，go 时要求 JWT_SECRET、
# DATABASE_URL、REDIS_HOST、MONGO_URI。抓取外网源的 source、
# sources/batch、hottest-analysis、recommended 与投递 BullMQ 的
# llm-backfill 不迁移，仍回 NestJS。compose pilot 保持 legacy。回滚=改回
# legacy。
API_GO_NEWSNOW_CLUSTERING_OPS_MODE=legacy
# 采集只读与媒体/遥测 7 条 HTTP（GET /api/crawl-tasks、GET
# /api/crawl-tasks/:id、GET /api/crawl-media-assets/:assetId/:mode、
# GET /api/admin/crawl4ai/quality、GET
# /api/admin/crawl4ai/quality/sources/:sourceId、POST /api/search-telemetry、
# GET /api/admin/search-telemetry/summary）。默认 legacy，只接受空串/
# legacy/go，非法值启动失败，go 时要求 JWT_SECRET、DATABASE_URL、
# REDIS_HOST、MONGO_URI。写队列与实时抓取接口（POST /api/crawl-tasks、
# DELETE /api/crawl-tasks/:id、POST /api/crawl-tasks/:id/retry、
# POST /api/crawl-tasks/metadata 与 /api/admin/crawl4ai/queue*）仍回
# NestJS。媒体资产复用 JWT_SECRET 做 HMAC 签名；质量快照与 Nest 共享
# ObservabilitySnapshot 与 60 秒缓存。compose pilot 保持 legacy。回滚只把
# 本变量改回 legacy。
API_GO_CRAWL_READ_TELEMETRY_MODE=legacy
# 网页元数据预览 1 条 HTTP（POST /api/crawl-tasks/metadata，权限
# crawl.read）。默认 legacy，只接受空串/legacy/go，非法值启动失败；go 时
# 要求 JWT_SECRET、DATABASE_URL、REDIS_HOST，不要求 MONGO_URI/S3/
# crawl4ai/STORAGE_MODE。go 只接管这一条精确 POST 及其 CORS 预检，成功返回
# 201 {orgId,total,results}；其他方法、GET /api/crawl-tasks/metadata 沿既有
# GET :id 归属、创建/重试/删除接口继续回 NestJS。发现缓存复用 Nest 的
# crawl:discover:http-state:<sha1(url)>（TTL 7 天），不写业务库。回滚只把本
# 变量改回 legacy。
API_GO_CRAWL_METADATA_MODE=legacy
# 搜索索引重建 2 条 HTTP（POST /api/admin/search/reindex 与
# GET /api/admin/search/reindex/:jobId，权限都是 settings.manage）。默认
# legacy，只接受空串/legacy/go，非法值启动失败，go 时要求 JWT_SECRET、
# DATABASE_URL、REDIS_HOST、MONGO_URI。go 只接管这两条精确路由：后台任务
# 写 Redis 的既有 search:reindex:job:<jobId> / search:reindex:org:<orgId> /
# search:reindex:orgs 与 lock:search:reindex:org:<orgId>，按 itemMetaId 游标
# 分批读 Mongo 的 itemreadmodels（每批 500）并 bulk 写入 Elasticsearch。
# 未启用 Elasticsearch 时沿用禁用分支（completed、indexed=0），不算真实
# 重建验收。遥测仍由 API_GO_CRAWL_READ_TELEMETRY_MODE 控制。本变量只决定
# 这两个 reindex 端点，不启动 worker、不投递 BullMQ。回滚只把本变量改回
# legacy。
API_GO_SEARCH_REINDEX_MODE=legacy
# 运行时与治理设置 18 条 HTTP（/api/system-settings 下的 rate-limit-policies
# 列表/创建/详情/更新/删除、rate-limits、auth-cache、audit-log、
# multi-tenant-schedulers、news-source-scheduler、newsnow-personalization 与
# newsnow-personalization/metrics）。默认 legacy，只接受空串/legacy/go，
# 非法值启动失败，go 时要求 JWT_SECRET、DATABASE_URL、REDIS_HOST（不要求
